---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  /** Wrap the page in the narrow reading column (posts, plain pages).
      Otherwise the page lays out its own `.container` sections. */
  narrow?: boolean;
}

const { narrow = false, ...props } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site">
      <Header />
      <main id="main">
        {narrow ? (
          <div class="container container--narrow">
            <slot />
          </div>
        ) : (
          <slot />
        )}
      </main>
      <Footer />
    </div>
  </body>
</html>
