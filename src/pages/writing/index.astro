---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = (
  await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Keep the authoring route useful without shipping an empty writing section.
if (posts.length === 0) return Astro.redirect('/#work');
---

<BaseLayout
  narrow
  title="Writing"
  description="Essays and technical writeups."
>
  <h1 style="font-size: 1.6rem; margin: 0 0 1.6rem;">Writing</h1>
  {posts.length === 0 ? (
    <p style="color: var(--fg-muted);">No posts yet.</p>
  ) : (
    <PostList posts={posts} />
  )}
</BaseLayout>
