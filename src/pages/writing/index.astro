---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Mark from '../../components/Mark.astro';
import { getCollection } from 'astro:content';

const posts = (
  await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Writing"
  description="Essays and technical writeups."
>
  <h1 style="font-size: 1.6rem; margin: 0 0 1.6rem;"><Mark size={10} class="page-mark" />Writing</h1>
  {posts.length === 0 ? (
    <p style="color: var(--fg-muted);">No posts yet.</p>
  ) : (
    <PostList posts={posts} />
  )}
</BaseLayout>
