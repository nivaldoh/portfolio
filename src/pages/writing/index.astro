---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = (
  await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  narrow
  title="Writing"
  description="Essays and technical writeups."
>
  <h1 class="section-heading writing__title">Writing</h1>
  {posts.length === 0 ? (
    <p class="writing__status">In construction.</p>
  ) : (
    <PostList posts={posts} />
  )}
</BaseLayout>

<style>
  .writing__title {
    margin: 0 0 1rem;
  }

  .writing__status {
    margin: 0;
    font: 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }
</style>
