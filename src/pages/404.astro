---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page does not exist.">
  <section style="text-align: center; padding: 4rem 0;">
    <h1 style="font-size: 4rem; margin: 0; letter-spacing: -0.02em;">404</h1>
    <p style="color: var(--fg-muted); margin: 0.5rem 0 1.5rem; max-width: 38ch; margin-left: auto; margin-right: auto;">
      Not in any catalogue we have. The coordinates resolve to nothing.
    </p>
    <p>
      <a href="/">← back to the front page</a>
    </p>
  </section>
</BaseLayout>
