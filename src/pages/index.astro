---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPanel from '../components/ProjectPanel.astro';
import BattleReplay from '../components/wh3/BattleReplay.astro';
import FlankTrace from '../components/wh3/FlankTrace.astro';
import RunProgress from '../components/slay/RunProgress.astro';
import DevelopmentRecordings from '../components/robocasa/DevelopmentRecordings.astro';
import ResultsChart from '../components/tcg/ResultsChart.astro';
import TeacherData from '../components/tcg/TeacherData.astro';
import HybridSearch from '../components/pokeagent/HybridSearch.astro';
import SelfPlayDiagram from '../components/pokeagent/SelfPlayDiagram.astro';
import MetamonPRs from '../components/pokeagent/MetamonPRs.astro';
import { BRACKETS_URL } from '../components/pokeagent/brackets';
import BeamSection from '../components/BeamSection.astro';
import Career from '../components/Career.astro';
import { EMAIL, RESUME_URL, SOCIAL_LINKS } from '../consts';

const projects = await getCollection(
  'projects',
  ({ data }) => import.meta.env.DEV || !data.draft
);
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));
const game = byId['game-agents'];
const tcg = byId['pokemon-tcg'];

// The hero's index of the work below, in page order.
const index = [
  { n: '01', href: '#work', title: 'Agents in real games', note: 'Total War · Slay the Spire' },
  { n: '02', href: '#pokeagent', title: 'PokéAgent Challenge', note: 'NeurIPS 2025 quarterfinalist' },
  { n: '03', href: '#metamon', title: 'Metamon', note: 'UT Austin RPL' },
  { n: '04', href: '#pokemon-tcg', title: 'Pokémon TCG agents', note: 'Kaggle' },
  { n: '05', href: '#robocasa', title: 'Changing robot goals', note: 'RoboCasa365' },
  { n: '06', href: '#beam', title: 'Apache Beam in Rust', note: 'Distributed systems' },
];
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 class="hero__title" id="hero-title">I build and evaluate AI agents.</h1>
      <p class="hero__lede">
        I build the interfaces that let agents act, then study what happens
        when they do.
      </p>
      <p class="hero__context">
        8+ years in cloud and data engineering. MS in Computer Science at
        UT Austin, expected 2027. São Paulo, Brazil.
      </p>
      <p class="hero__open">
        Open to AI and research engineering roles:
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
      <nav class="hero__index" aria-label="Selected work">
        <ol>
          {index.map((item) => (
            <li>
              <a href={item.href}>
                <span class="hero__index-n">{item.n}</span>
                <span class="hero__index-title">{item.title}</span>
                <span class="hero__index-note">{item.note}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
    <FlankTrace class="hero__visual" />
  </section>

  <section id="work" class="feature" aria-labelledby="feature-title">
    <div class="container">
      <div class="feature__head">
        <div>
          <p class="eyebrow">01 / Game environments and evaluation</p>
          <h2 class="section-heading" id="feature-title">
            <a href={`/projects/${game.id}/`}>Agents in real games</a>
          </h2>
        </div>
        <div>
          <p class="feature__summary">
            Language models play Total War and Slay the Spire through game
            interfaces and evaluation tools I built. Every decision is
            recorded, so I can replay a battle or a run and check what the
            model saw, what it ordered and what the game actually did.
          </p>
          <ul class="link-row">
            <li><a href={`/projects/${game.id}/`}>Case study</a></li>
            <li><a href="https://github.com/nivaldoh/slay_the_spire_ai" rel="noopener">Code</a></li>
          </ul>
        </div>
      </div>

      <section class="game" id="total-war" aria-labelledby="total-war-title">
        <div class="game__head game__head--cta">
          <div>
            <h3 class="game__title" id="total-war-title">Total War: WARHAMMER III</h3>
            <p class="game__kind">Real-time battles</p>
          </div>
          <a class="action benchmark-cta" href="/benchmarks/total-war/index.html">
            <span class="benchmark-cta__text">
              <span class="benchmark-cta__title">Open the full benchmark</span>
              <span class="benchmark-cta__note">Six scenarios · model comparisons · battle replays</span>
            </span>
            <svg class="benchmark-cta__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9.5M8.5 4l4 4-4 4" /></svg>
          </a>
        </div>
        <p class="feature__point">
          The LLM’s cavalry (<span class="ink-model">in&nbsp;blue</span>) rides
          around the halberd screen and into the guns behind it, while its
          horse archers pull a halberd unit away. Its orders act on a view of
          the battle that is typically 5&nbsp;s old.
        </p>
        <BattleReplay variant="feature" />
      </section>

      <section class="game" id="slay-the-spire" aria-labelledby="spire-title">
        <div class="game__head">
          <h3 class="game__title" id="spire-title">Slay the Spire</h3>
          <p class="game__kind">Whole runs, one decision at a time</p>
        </div>
        <p class="feature__point">
          A model plays complete Ironclad runs. When one goes wrong, I first
          check whether the model chose badly or the interface misled it.
        </p>
        <RunProgress />
        <p class="game__note">
          <span class="game__note-label">One diagnosis</span>
          With the Gambling Chip relic the game asks which cards to discard,
          but the prompt read like any other card choice, so the model
          sometimes discarded cards it meant to play. The latest prompt says
          the selection is Gambling Chip’s; it hasn’t had a full run yet.
        </p>
        <ul class="link-row game__links">
          <li><a href="https://github.com/nivaldoh/slay_the_spire_ai/blob/main/docs/spire/fullrun/README.md" rel="noopener">Run notes</a></li>
        </ul>
      </section>
    </div>
  </section>

  <section id="thread" class="thread container" aria-labelledby="thread-title">
    <div class="thread__head">
      <h2 class="section-heading" id="thread-title">From PokéAgent to RoboCasa365</h2>
    </div>

    <ol class="thread__list">
      <li class="thread__step">
        <p class="thread__when">Late 2025</p>
        <ProjectPanel
          id="pokeagent"
          level={3}
          eyebrow="02 / NeurIPS 2025 competition"
          title="PokéAgent Challenge"
          href="/projects/pokeagent-metamon/"
          facts={['Quarterfinalist · Gen 1 OU', 'Quarterfinalist · Gen 9 OU']}
          summary="I competed as MetaHorns. My Gen 9 OU entry combined two existing agents: PokéChamp’s minimax search looks one turn ahead, and Metamon, trained with offline RL on human battles, proposes the moves and scores each position. I also packaged Metamon self-play to run on Google Cloud Run."
          links={[
            { label: 'Case study', url: '/projects/pokeagent-metamon/' },
            { label: 'Official brackets', url: BRACKETS_URL },
            { label: 'Hybrid code', url: 'https://github.com/nivaldoh/pokechamp/tree/635aa8d81a1fe73e817fd3d01e5c14a8485917e9' },
            { label: 'Self-play code', url: 'https://github.com/nivaldoh/metamon_pokeagent_comp/tree/443b841252792e81775133208fa5c3c820b5cb31' },
          ]}
          textFirst
        >
          <div class="figure-pair" slot="media">
            <div class="figure-pair__item">
              <h4 class="figure-pair__title">Deciding a turn</h4>
              <HybridSearch />
            </div>
            <div class="figure-pair__item">
              <h4 class="figure-pair__title">Generating training data</h4>
              <SelfPlayDiagram compact />
            </div>
          </div>
        </ProjectPanel>
      </li>

      <li class="thread__step">
        <p class="thread__when">Early 2026</p>
        <ProjectPanel
          id="metamon"
          level={3}
          eyebrow="03 / Open source · UT Austin RPL"
          title="Metamon"
          href="/projects/pokeagent-metamon/#metamon-contributions"
          summary="From January to March 2026 I worked on Metamon with PhD student Jake Grigsby at UT Austin’s Robot Perception and Learning Lab. My main merged change took its team validation from about a second per team to about a millisecond."
          links={[
            { label: 'Case study', url: '/projects/pokeagent-metamon/#metamon-contributions' },
            { label: 'Repository', url: 'https://github.com/UT-Austin-RPL/metamon' },
          ]}
          layout="wide"
        >
          <MetamonPRs slot="media" />
        </ProjectPanel>
      </li>

      <li class="thread__step">
        <p class="thread__when">Jun–Jul 2026</p>
        <ProjectPanel
          id={tcg.id}
          level={3}
          eyebrow="04 / Kaggle competition"
          title="Pokémon TCG agents"
          href={`/projects/${tcg.id}/`}
          summary="A Kaggle competition close to Metamon’s problem, but with no archive of human games to learn from. I recorded games between four scripted players, cloned them, then fine-tuned with PPO. A later specialist won 82.6% against one teacher; checking how, I found every win came from the opponent running out of cards."
          links={[{ label: 'Case study', url: `/projects/${tcg.id}/` }]}
          layout="wide"
          size="small"
        >
          <TeacherData />
          <ResultsChart slot="media" variant="multi-deck" compact />
        </ProjectPanel>
      </li>

      <li class="thread__step">
        <p class="thread__when">Sep 2026</p>
        <ProjectPanel
          id="robocasa"
          level={3}
          eyebrow="05 / Robot evaluation"
          title="Changing goals during robot execution"
          summary="I extended RoboCasa365, a kitchen simulation benchmark from the same UT Austin lab as Metamon, so the goal or the scene can change mid-episode, and recorded when each controller received the change. In 4 goal-change episodes, GR00T N1.5 completed the original task every time and the new goal never. Astra, my code-writing LLM agent with ground-truth state and evaluator feedback, met the new goal in 1 of 5 episodes. The clips are not from the evaluation."
          links={[
            { label: 'Paper (PDF, workshop submission, under review)', url: '/media/robocasa/teleporting-bread-and-changing-goals.pdf' },
            { label: 'Code', url: 'https://github.com/nivaldoh/robocasa/tree/main/robocasa/scenarios' },
          ]}
          layout="wide"
        >
          <DevelopmentRecordings slot="media" />
        </ProjectPanel>
      </li>
    </ol>
  </section>

  <BeamSection />

  <section id="about" class="about container" aria-labelledby="about-title">
    <div class="feature__head about__head">
      <h2 class="section-heading" id="about-title">Background</h2>
      <p class="about__bio">
        I’m a software and AI engineer in São Paulo. After eight years
        building cloud and data systems, I now work on agents in games and
        robotics while studying for an MS in Computer Science at UT Austin.
        The agent work began in 2025, when a post by Prof. Yuke Zhu pointed
        me to the PokéAgent Challenge; Metamon and RoboCasa365 both come from
        his lab.
      </p>
    </div>
    <Career />
  </section>

  <section id="contact" class="contact container" aria-labelledby="contact-title">
    <div class="contact__card">
      <div>
        <h2 class="contact__title" id="contact-title">Contact</h2>
        <p class="contact__line">Open to AI and research engineering roles.</p>
      </div>
      <div class="contact__reach">
        <p class="contact__email">
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <button class="contact__copy" type="button" data-copy={EMAIL} hidden>Copy</button>
          <span class="visually-hidden" role="status" data-copy-status></span>
        </p>
        <ul class="contact__links">
          {SOCIAL_LINKS.map((l) => (
            <li><a href={l.url} rel="me noopener">{l.label}</a></li>
          ))}
          <li><a href={RESUME_URL}>Résumé (PDF)</a></li>
        </ul>
      </div>
    </div>
  </section>

  <script>
    // Copy the address; the button stays hidden without the Clipboard API.
    const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    if (copy && navigator.clipboard) {
      let reset: number | undefined;
      copy.hidden = false;
      copy.addEventListener('click', async () => {
        let message = 'Copied';
        try {
          await navigator.clipboard.writeText(copy.dataset.copy ?? '');
        } catch {
          message = 'Copy failed';
        }
        copy.textContent = message;
        if (status) status.textContent = message === 'Copied' ? 'Email address copied' : message;
        window.clearTimeout(reset);
        reset = window.setTimeout(() => {
          copy.textContent = 'Copy';
          if (status) status.textContent = '';
        }, 2000);
      });
    }
  </script>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero__title {
    font-size: var(--step-4);
    font-weight: 380;
    line-height: 1.02;
    margin: 0;
    max-width: 12ch;
  }

  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.5;
    margin: 1.6rem 0 0;
    max-width: 34ch;
  }

  .hero__context {
    color: var(--fg-muted);
    font-size: var(--step--1);
    margin: 1rem 0 0;
    max-width: 42ch;
  }

  .hero__open {
    margin: 0.4rem 0 0;
    font-size: var(--step--1);
    color: var(--fg);
  }

  /* The index of the work below: number, title and a short note. */
  .hero__index {
    margin-top: 2.2rem;
    max-width: 34rem;
  }

  .hero__index ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .hero__index a {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr) auto;
    gap: 0 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0.1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--fg-strong);
    text-decoration: none;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .hero__index a:hover {
    color: var(--accent);
    background: linear-gradient(to right, color-mix(in srgb, var(--accent) 7%, transparent), transparent 70%);
  }

  .hero__index-n {
    font: 0.8rem/1.4 var(--font-mono);
    color: var(--accent);
  }

  .hero__index-title {
    font-size: var(--step-0);
    line-height: 1.35;
  }

  .hero__index-note {
    font: var(--step--2)/1.4 var(--font-mono);
    color: var(--fg-muted);
    text-align: right;
  }

  @media (max-width: 30rem) {
    .hero__index a {
      grid-template-columns: 2.1rem minmax(0, 1fr);
    }

    .hero__index-note {
      grid-column: 2;
      text-align: left;
    }
  }

  /* A square (FlankTrace's own root, hence :global): cap it until it shares
     the row with the headline. */
  .hero :global(.hero__visual) {
    width: 100%;
    max-width: 34rem;
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 4rem;
    }

    .hero :global(.hero__visual) {
      max-width: none;
    }
  }

  /* ---------- Featured projects ---------- */
  .feature {
    background: var(--bg-elev);
    border-block: 1px solid var(--rule);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .feature__head {
    display: grid;
    gap: 1rem 3.5rem;
    margin-bottom: 2rem;
  }

  .feature__head .section-heading {
    margin: 0;
  }

  .feature__head .section-heading a {
    color: var(--fg-strong);
    text-decoration: none;
  }

  .feature__head .section-heading a:hover {
    color: var(--accent);
  }

  .feature__summary {
    margin: 0 0 0.9rem;
    max-width: 52ch;
  }

  /* The one thing to see in the replay, set just above it. */
  .feature__point {
    margin: 0 0 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--fg-strong);
    max-width: 48ch;
  }

  .ink-model {
    color: var(--data-model);
  }

  /* One game of the project: a ruled header, the point, the figure. */
  .game + .game {
    margin-top: clamp(3.5rem, 2rem + 4vw, 5.5rem);
  }

  .game__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1.5rem;
    margin-bottom: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .game__title {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 460;
    line-height: 1.15;
    color: var(--fg-strong);
  }

  .game__kind {
    margin: 0;
    font: 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  /* In a game block the point sits under the ruled header, not on a rule. */
  .game .feature__point {
    padding-top: 0;
    border-top: 0;
  }

  .game__links {
    margin-top: 0.8rem;
  }

  /* A finding under a figure: smaller than the point, set off by a rule. */
  .game__note {
    margin: 1.4rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    max-width: 62ch;
    color: var(--fg);
  }

  .game__note-label {
    display: block;
    margin-bottom: 0.2rem;
    font: var(--step--2)/1.4 var(--font-mono);
    color: var(--accent);
  }

  .game__head--cta {
    align-items: center;
  }

  .game__head--cta .game__kind {
    margin-top: 0.3rem;
  }

  /* The way into the full benchmark: a large button beside the title. */
  .benchmark-cta {
    gap: 1.1rem;
    padding: 0.75rem 1.1rem 0.75rem 1.25rem;
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-control));
  }

  .benchmark-cta:hover {
    background: color-mix(in srgb, var(--accent) 14%, var(--bg-control));
  }

  .benchmark-cta__text {
    display: grid;
    gap: 0.15rem;
  }

  .benchmark-cta__title {
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--fg-strong);
  }

  .benchmark-cta__note {
    font: var(--step--2)/1.4 var(--font-mono);
    color: var(--fg-muted);
  }

  .benchmark-cta__arrow {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 120ms ease;
  }

  .benchmark-cta:hover .benchmark-cta__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 40rem) {
    .benchmark-cta {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (min-width: 60rem) {
    .feature__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
    }
  }

  /* ---------- The thread: PokéAgent to RoboCasa ---------- */
  .thread {
    padding-top: var(--space-section);
  }

  .thread__head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* A dated spine down the left; each step hangs a dot on it. */
  .thread__list {
    --spine: 0.4rem;
    --indent: 1.75rem;
    position: relative;
    display: grid;
    gap: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thread__list::before {
    content: '';
    position: absolute;
    left: var(--spine);
    top: 0.5rem;
    bottom: 0;
    width: 1px;
    background: linear-gradient(var(--border) 88%, transparent);
  }

  .thread__step {
    position: relative;
    padding-left: var(--indent);
  }

  .thread__when {
    margin: 0 0 0.9rem;
    font: 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--fg-strong);
  }

  .thread__when::before {
    content: '';
    position: absolute;
    left: calc(var(--spine) - 4px);
    top: 0.25rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }

  @media (min-width: 60rem) {
    .thread__list {
      --spine: 6.6rem;
      --indent: 8.6rem;
    }

    .thread__when {
      position: absolute;
      left: 0;
      top: 0;
      width: 5.6rem;
      margin: 0;
      text-align: right;
    }
  }

  /* Two figures side by side, each under a small heading. */
  .figure-pair {
    display: grid;
    gap: 2.2rem 2.5rem;
    align-items: start;
  }

  .figure-pair__item {
    min-width: 0;
  }

  .figure-pair__title {
    margin: 0 0 0.7rem;
    font: 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    font-weight: 400;
    color: var(--fg-muted);
  }

  @media (min-width: 60rem) {
    .figure-pair {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* ---------- Background ---------- */
  .about {
    padding-top: var(--space-section);
  }

  .about__head {
    margin-bottom: 1.2rem;
  }

  .about__bio {
    margin: 0;
    max-width: 52ch;
  }

  /* ---------- Contact ---------- */
  .contact {
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .contact__card {
    display: grid;
    gap: 1.4rem 3rem;
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2.2rem) clamp(1.2rem, 3vw, 2.4rem);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-plate);
  }

  .contact__title {
    margin: 0 0 0.5rem;
    font: 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .contact__line {
    margin: 0;
    max-width: 24ch;
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--fg-strong);
    text-wrap: balance;
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    margin: 0 0 1rem;
    font-size: var(--step-2);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .contact__copy {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--bg-control);
    color: var(--fg);
    font: var(--step--2)/1.4 var(--font-mono);
    cursor: pointer;
  }

  .contact__copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

