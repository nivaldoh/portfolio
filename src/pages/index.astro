---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPanel from '../components/ProjectPanel.astro';
import BattleReplay from '../components/wh3/BattleReplay.astro';
import HeroBattle from '../components/wh3/HeroBattle.astro';
import CheckpointBranches from '../components/wh3/CheckpointBranches.astro';
import ResultsGrid from '../components/wh3/ResultsGrid.astro';
import TeamPlan from '../components/wh3/TeamPlan.astro';
import RunProgress from '../components/slay/RunProgress.astro';
import DevelopmentRecordings from '../components/robocasa/DevelopmentRecordings.astro';
import ResultsChart from '../components/tcg/ResultsChart.astro';
import TeacherData from '../components/tcg/TeacherData.astro';
import HybridSearch from '../components/pokeagent/HybridSearch.astro';
import SelfPlayDiagram from '../components/pokeagent/SelfPlayDiagram.astro';
import MetamonPRs from '../components/pokeagent/MetamonPRs.astro';
import { BRACKETS_URL } from '../components/pokeagent/brackets';
import BeamSection from '../components/BeamSection.astro';
import Career from '../components/Career.astro';
import { EMAIL, RESUME_URL, SOCIAL_LINKS } from '../consts';

const projects = await getCollection(
  'projects',
  ({ data }) => import.meta.env.DEV || !data.draft
);
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));
const game = byId['game-agents'];
const tcg = byId['pokemon-tcg'];

// The hero's index of the work below, in page order.
const index = [
  { n: '01', href: '#work', title: 'Agents in Total War', note: 'Live battles · saves · benchmark' },
  { n: '02', href: '#pokeagent', title: 'PokéAgent Challenge', note: 'NeurIPS 2025 quarterfinalist' },
  { n: '03', href: '#metamon', title: 'Metamon', note: 'UT Austin RPL' },
  { n: '04', href: '#pokemon-tcg', title: 'Pokémon TCG agents', note: 'Kaggle' },
  { n: '05', href: '#robocasa', title: 'Changing robot goals', note: 'RoboCasa365' },
  { n: '06', href: '#beam', title: 'Apache Beam in Rust', note: 'Distributed systems' },
];

// The Total War project in numbers, as of 2 November 2026, from the game-agents
// repository (github.com/nivaldoh/slay_the_spire_ai): rows of
// docs/twwarhammer3/results.csv (scripted and model battles, 13 Oct to 2 Nov); distinct
// models in it (OpenAI, Anthropic, Z.ai, Moonshot AI, Qwen, StepFun); the agreed
// checkpoint check (docs/agreed-checks.md: 0 checksum mismatches over 2,001 ticks);
// git rev-list --count HEAD (both games; first commit 11 Oct 2026).
const stats = [
  { n: '650+', label: 'battles recorded' },
  { n: '9', label: 'models have played' },
  { n: '2,001', label: 'restored ticks, all matching the original' },
  { n: '1,215', label: 'commits in 3 weeks' },
];

// The whole repository (both games), as of 2 November 2026: git rev-list --count HEAD;
// `def test_` lines under tests/twwarhammer3; the planted-version replay at 515491c
// (runs/cleanup-20261102, agreed check); wc -l of src/twwarhammer3 and the battle script.
const buildFacts = [
  { n: '920', label: 'Total War tests' },
  { n: '341 of 341', label: 'deliberately planted bugs caught by the tests' },
];
---

<BaseLayout>
  <HeroBattle ctaHref="#work" benchmarkHref="/benchmarks/total-war/index.html" />

  <section class="intro container" aria-labelledby="intro-title">
    <div class="intro__text">
      <h2 class="intro__title" id="intro-title">I build environments and evaluations for AI agents.</h2>
      <p class="intro__context">
        8+ years in cloud and data engineering. MS in Computer Science at
        UT Austin, expected 2027. São Paulo, Brazil.
      </p>
      <p class="intro__open">
        Open to AI and research engineering roles:
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
    </div>
    <nav class="hero__index" aria-label="Selected work">
      <ol>
        {index.map((item) => (
          <li>
            <a href={item.href}>
              <span class="hero__index-n">{item.n}</span>
              <span class="hero__index-title">{item.title}</span>
              <span class="hero__index-note">{item.note}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <section id="work" class="feature" aria-labelledby="feature-title">
    <div class="container">
      <div class="feature__head">
        <div>
          <p class="eyebrow">01 / Total War: WARHAMMER III</p>
          <h2 class="section-heading" id="feature-title">
            <a href={`/projects/${game.id}/`}>Agents in a real-time strategy game</a>
          </h2>
        </div>
        <div>
          <p class="feature__summary">
            A Lua mod I built is the models’ only way into the game: game state in,
            orders out. Nothing reads the screen or moves the mouse. A model sees
            enemies only while its army can, and its thinking time counts against it.
          </p>
          <ul class="link-row">
            <li><a href={`/projects/${game.id}/`}>Case study</a></li>
            <li><a href="https://github.com/nivaldoh/slay_the_spire_ai" rel="noopener">Code</a></li>
            <li><a href="/benchmarks/total-war/index.html">Benchmark</a></li>
          </ul>
        </div>
      </div>

      <ul class="stats" aria-label="The Total War project in numbers, as of 2 November 2026">
        {stats.map((s) => (
          <li class="stat"><span class="stat__n">{s.n}</span><span class="stat__label">{s.label}</span></li>
        ))}
      </ul>

      <section class="chapter" id="total-war" aria-labelledby="ch-live">
        <div class="chapter__head">
          <h3 class="chapter__title" id="ch-live">Five seconds behind.</h3>
          <p class="chapter__lede">
            The battle keeps moving while the model thinks: the view behind each batch of
            orders was 5.4&nbsp;s old on median. Here gpt-6-sol’s cavalry
            (<span class="ink-model">in&nbsp;blue</span>) rides around the halberd screen and
            into the guns behind it.
          </p>
        </div>
        <BattleReplay variant="feature" />
      </section>

      <section class="chapter" id="checkpoints" aria-labelledby="ch-save">
        <div class="chapter__head">
          <h3 class="chapter__title" id="ch-save">Save a battle. Try another future.</h3>
          <p class="chapter__lede">
            Total War can’t save mid-battle. I built a save from the game’s own replay file: a
            restore fast-forwards to the saved moment, checking the engine’s checksum on every
            tick, then plays on live. Below, one saved moment plays out four ways.
          </p>
        </div>
        <CheckpointBranches>
          <figcaption class="chapter__caption">
            Six restores with five different orders; two played the same battle as “Both units
            attack”. In my check of a restored battle, all 2,001 ticks matched the original.
            Restores like these drive a small reinforcement-learning loop (early, mixed
            results in the <a href={`/projects/${game.id}/#save-a-battle-try-another-future`}>case study</a>).
            The <a href="https://github.com/nivaldoh/wh3-battle-checkpoints" rel="noopener">save tool is public</a>.
          </figcaption>
        </CheckpointBranches>
      </section>

      <section class="chapter chapter--split" id="benchmark" aria-labelledby="ch-bench">
        <div class="chapter__head">
          <h3 class="chapter__title" id="ch-bench">Which models can win?</h3>
          <p class="chapter__lede">
            Six scenarios, each built around one tactical decision, against the game’s AI
            on very hard. Each dot is one battle: click it to watch the replay.
          </p>
          <p class="chapter__note">
            Scripted rules lost all 27 of their battles here. Three battles per model is a
            small sample, and I developed the prompts on these scenarios.
          </p>
          <a class="action benchmark-cta" href="/benchmarks/total-war/index.html">
            <span class="benchmark-cta__text">
              <span class="benchmark-cta__title">Open the full benchmark</span>
              <span class="benchmark-cta__note">Scenarios · models · every battle replay</span>
            </span>
            <svg class="benchmark-cta__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9.5M8.5 4l4 4-4 4" /></svg>
          </a>
        </div>
        <ResultsGrid />
      </section>

      <section class="chapter" id="multiplayer" aria-labelledby="ch-team">
        <div class="chapter__head">
          <h3 class="chapter__title" id="ch-team">Next: agents as teammates.</h3>
          <p class="chapter__lede">
            Each agent gets its own copy of the game and sees only what its player can see.
            The game’s own multiplayer joins them in one battle.
          </p>
        </div>
        <TeamPlan />
      </section>

      <section class="game chapter" id="slay-the-spire" aria-labelledby="spire-title">
        <div class="game__head">
          <h3 class="game__title" id="spire-title">Slay the Spire</h3>
          <p class="game__kind">Same project · turn-based full runs</p>
        </div>
        <p class="feature__point">
          A model plays complete Ironclad runs. When one goes wrong, I first
          check whether the model chose badly or the interface misled it.
        </p>
        <RunProgress />
        <ul class="link-row game__links">
          <li><a href="https://github.com/nivaldoh/slay_the_spire_ai/blob/main/docs/spire/fullrun/README.md" rel="noopener">Run notes</a></li>
        </ul>
      </section>

      <section class="build" aria-labelledby="build-title">
        <h3 class="build__title" id="build-title">How I build it</h3>
        <p class="build__text">
          Claude Code and Codex agents write most of the code. I decide what to build and
          how to check it: nothing counts as working until a check I agreed on passes.
        </p>
        <ul class="build__facts">
          {buildFacts.map((f) => (
            <li><span class="build__n">{f.n}</span> {f.label}</li>
          ))}
        </ul>
      </section>
    </div>
  </section>

  <section id="thread" class="thread container" aria-labelledby="thread-title">
    <div class="thread__head">
      <h2 class="section-heading" id="thread-title">From PokéAgent to RoboCasa365</h2>
    </div>

    <ol class="thread__list">
      <li class="thread__step">
        <p class="thread__when">Late 2025</p>
        <ProjectPanel
          id="pokeagent"
          level={3}
          eyebrow="02 / NeurIPS 2025 competition"
          title="PokéAgent Challenge"
          href="/projects/pokeagent-metamon/"
          facts={['Quarterfinalist · Gen 1 OU', 'Quarterfinalist · Gen 9 OU']}
          summary="I competed as MetaHorns. My Gen 9 OU entry combined two existing agents: PokéChamp’s minimax search looks one turn ahead, and Metamon, trained with offline RL on human battles, proposes the moves and scores each position. I also packaged Metamon self-play to run on Google Cloud Run."
          links={[
            { label: 'Case study', url: '/projects/pokeagent-metamon/' },
            { label: 'Official brackets', url: BRACKETS_URL },
            { label: 'Hybrid code', url: 'https://github.com/nivaldoh/pokechamp/tree/635aa8d81a1fe73e817fd3d01e5c14a8485917e9' },
            { label: 'Self-play code', url: 'https://github.com/nivaldoh/metamon_pokeagent_comp/tree/443b841252792e81775133208fa5c3c820b5cb31' },
          ]}
          textFirst
        >
          <div class="figure-pair" slot="media">
            <div class="figure-pair__item">
              <h4 class="figure-pair__title">Deciding a turn</h4>
              <HybridSearch />
            </div>
            <div class="figure-pair__item">
              <h4 class="figure-pair__title">Generating training data</h4>
              <SelfPlayDiagram compact />
            </div>
          </div>
        </ProjectPanel>
      </li>

      <li class="thread__step">
        <p class="thread__when">Early 2026</p>
        <ProjectPanel
          id="metamon"
          level={3}
          eyebrow="03 / Open source · UT Austin RPL"
          title="Metamon"
          href="/projects/pokeagent-metamon/#metamon-contributions"
          summary="From January to March 2026 I worked on Metamon with PhD student Jake Grigsby at UT Austin’s Robot Perception and Learning Lab. My main merged change took its team validation from about a second per team to about a millisecond."
          links={[
            { label: 'Case study', url: '/projects/pokeagent-metamon/#metamon-contributions' },
            { label: 'Repository', url: 'https://github.com/UT-Austin-RPL/metamon' },
          ]}
          layout="wide"
        >
          <MetamonPRs slot="media" />
        </ProjectPanel>
      </li>

      <li class="thread__step">
        <p class="thread__when">Jun–Jul 2026</p>
        <ProjectPanel
          id={tcg.id}
          level={3}
          eyebrow="04 / Kaggle competition"
          title="Pokémon TCG agents"
          href={`/projects/${tcg.id}/`}
          summary="A Kaggle competition close to Metamon’s problem, but with no archive of human games to learn from. I recorded games between four scripted players, cloned them, then fine-tuned with PPO. A later specialist won 82.6% against one teacher, but when I checked, every win came from the opponent running out of cards."
          links={[{ label: 'Case study', url: `/projects/${tcg.id}/` }]}
          layout="wide"
          size="small"
        >
          <TeacherData />
          <ResultsChart slot="media" variant="multi-deck" compact />
        </ProjectPanel>
      </li>

      <li class="thread__step">
        <p class="thread__when">Sep 2026</p>
        <ProjectPanel
          id="robocasa"
          level={3}
          eyebrow="05 / Robot evaluation"
          title="Changing goals during robot execution"
          summary="I extended RoboCasa365, a kitchen simulation benchmark from the same UT Austin lab as Metamon, so the goal or the scene can change mid-episode, and recorded when each controller received the change. In 4 goal-change episodes, GR00T N1.5 always completed the original task, but never the new goal. Astra, my code-writing LLM agent with ground-truth state and evaluator feedback, met the new goal in 1 of 5 episodes. The clips are not from the evaluation."
          links={[
            { label: 'Paper (PDF, workshop submission, under review)', url: '/media/robocasa/teleporting-bread-and-changing-goals.pdf' },
            { label: 'Code', url: 'https://github.com/nivaldoh/robocasa/tree/main/robocasa/scenarios' },
          ]}
          layout="wide"
        >
          <DevelopmentRecordings slot="media" />
        </ProjectPanel>
      </li>
    </ol>
  </section>

  <BeamSection />

  <section id="about" class="about container" aria-labelledby="about-title">
    <div class="feature__head about__head">
      <h2 class="section-heading" id="about-title">Background</h2>
      <p class="about__bio">
        I’m a software and AI engineer in São Paulo. After eight years
        building cloud and data systems, I now work on agents in games and
        robotics while studying for an MS in Computer Science at UT Austin.
        The agent work began in 2025, when a post by Prof. Yuke Zhu pointed
        me to the PokéAgent Challenge. Metamon and RoboCasa365 both come from
        his lab.
      </p>
    </div>
    <Career />
  </section>

  <section id="contact" class="contact container" aria-labelledby="contact-title">
    <div class="contact__card">
      <div>
        <h2 class="contact__title" id="contact-title">Contact</h2>
        <p class="contact__line">Open to AI and research engineering roles.</p>
      </div>
      <div class="contact__reach">
        <p class="contact__email">
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <button class="contact__copy" type="button" data-copy={EMAIL} hidden>Copy</button>
          <span class="visually-hidden" role="status" data-copy-status></span>
        </p>
        <ul class="contact__links">
          {SOCIAL_LINKS.map((l) => (
            <li><a href={l.url} rel="me noopener">{l.label}</a></li>
          ))}
          <li><a href={RESUME_URL}>Résumé (PDF)</a></li>
        </ul>
      </div>
    </div>
  </section>

  <script>
    // Copy the address; the button stays hidden without the Clipboard API.
    const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    if (copy && navigator.clipboard) {
      let reset: number | undefined;
      copy.hidden = false;
      copy.addEventListener('click', async () => {
        let message = 'Copied';
        try {
          await navigator.clipboard.writeText(copy.dataset.copy ?? '');
        } catch {
          message = 'Copy failed';
        }
        copy.textContent = message;
        if (status) status.textContent = message === 'Copied' ? 'Email address copied' : message;
        window.clearTimeout(reset);
        reset = window.setTimeout(() => {
          copy.textContent = 'Copy';
          if (status) status.textContent = '';
        }, 2000);
      });
    }
  </script>
</BaseLayout>

<style>
  /* ---------- Who I am, and the index of the work ---------- */
  .intro {
    display: grid;
    gap: 2rem 4rem;
    align-items: start;
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .intro__title {
    margin: 0;
    max-width: 22ch;
    font-size: var(--step-2);
    font-weight: 460;
    line-height: 1.2;
  }

  .intro__context {
    color: var(--fg-muted);
    font-size: var(--step--1);
    margin: 0.9rem 0 0;
    max-width: 44ch;
  }

  .intro__open {
    margin: 0.4rem 0 0;
    font-size: var(--step--1);
  }

  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  /* The index of the work below: number, title and a short note. */
  .hero__index ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .hero__index a {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr) auto;
    gap: 0 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0.1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--fg-strong);
    text-decoration: none;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .hero__index a:hover {
    color: var(--accent);
    background: linear-gradient(to right, color-mix(in srgb, var(--accent) 7%, transparent), transparent 70%);
  }

  .hero__index-n {
    font: 0.8rem/1.4 var(--font-mono);
    color: var(--accent);
  }

  .hero__index-title {
    font-size: var(--step-0);
    line-height: 1.35;
  }

  .hero__index-note {
    font: var(--step--2)/1.4 var(--font-mono);
    color: var(--fg-muted);
    text-align: right;
  }

  @media (max-width: 30rem) {
    .hero__index a {
      grid-template-columns: 2.1rem minmax(0, 1fr);
    }

    .hero__index-note {
      grid-column: 2;
      text-align: left;
    }
  }

  /* ---------- Total War: numbers and chapters ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0 0 clamp(3rem, 6vw, 4.5rem);
    padding: 0;
    list-style: none;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-plate);
    overflow: hidden;
  }

  .stat {
    display: grid;
    gap: 0.15rem;
    padding: 1rem 1.1rem 0.9rem;
    background: var(--bg-elev);
  }

  .stat__n {
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1;
    color: var(--fg-strong);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .stat__label {
    font: var(--step--2)/1.4 var(--font-mono);
    color: var(--fg-muted);
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .chapter + .chapter,
  .chapter + .build {
    margin-top: clamp(4rem, 2.5rem + 5vw, 6.5rem);
  }

  .chapter__head {
    margin-bottom: 1.3rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }

  .chapter__title {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 420;
    line-height: 1.1;
  }

  .chapter__lede {
    margin: 0.7rem 0 0;
    max-width: 58ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--fg);
  }

  .chapter__note {
    margin: 0.7rem 0 0;
    max-width: 52ch;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .chapter__caption {
    margin-top: 0.9rem;
    max-width: 78ch;
    color: var(--fg-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .chapter .benchmark-cta {
    margin-top: 1.4rem;
  }

  /* Text beside the figure on wide screens. */
  @media (min-width: 64rem) {
    .chapter--split {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 0 3.5rem;
      align-items: start;
    }

    .chapter--split .chapter__head {
      margin-bottom: 0;
    }
  }

  /* How the work is done: one line and three facts. */
  .build {
    display: grid;
    gap: 0.8rem 3.5rem;
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-plate);
    background: var(--bg-plate);
  }

  .build__title {
    margin: 0;
    font: 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--accent);
    font-weight: 400;
  }

  .build__text {
    margin: 0;
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--fg-strong);
  }

  .build__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .build__n {
    font-family: var(--font-mono);
    color: var(--fg-strong);
  }

  @media (min-width: 64rem) {
    .build {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: 'title title' 'text facts';
      align-items: center;
    }

    .build__title { grid-area: title; }
    .build__text { grid-area: text; }
    .build__facts { grid-area: facts; flex-direction: column; }
  }

  /* ---------- Featured projects ---------- */
  .feature {
    background: var(--bg-elev);
    border-block: 1px solid var(--rule);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .feature__head {
    display: grid;
    gap: 1rem 3.5rem;
    margin-bottom: 2rem;
  }

  .feature__head .section-heading {
    margin: 0;
  }

  .feature__head .section-heading a {
    color: var(--fg-strong);
    text-decoration: none;
  }

  .feature__head .section-heading a:hover {
    color: var(--accent);
  }

  .feature__summary {
    margin: 0 0 0.9rem;
    max-width: 52ch;
  }

  /* The one thing to see in the replay, set just above it. */
  .feature__point {
    margin: 0 0 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--fg-strong);
    max-width: 48ch;
  }

  .ink-model {
    color: var(--data-model);
  }

  /* One game of the project: a ruled header, the point, the figure. */
  .chapter + .game,
  .game + .build {
    margin-top: clamp(4rem, 2.5rem + 5vw, 6.5rem);
  }

  .game__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1.5rem;
    margin-bottom: 1rem;
    padding-top: 1rem;
