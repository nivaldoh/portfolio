---
// Recorded Total War: WARHAMMER III battle, replayed from the exported JSON.
// The server renders a complete, captioned still at the key moment (no script
// needed); the browser fetches the recording when the widget nears the viewport
// and enhances the same markup with playback. Positions are never interpolated.
import fs from 'node:fs';
import path from 'node:path';
import { appliedOrder, clock, momentAt, type Replay } from './replay-core';
import {
  decisionHTML,
  end,
  frameOf,
  furnitureSVG,
  groundSVG,
  mapLabel,
  noteHTML,
  pctOf,
  start,
  stripHTML,
  timeText,
  timeValueText,
  unitListHTML,
  unitsSVG,
  viewBox,
  viewText,
  waitingText,
} from './replay-render';

interface Props {
  /** `feature`: homepage (map key folded). `full`: case study (map key open, event list). */
  variant?: 'feature' | 'full';
  class?: string;
}

const { variant = 'feature', class: className } = Astro.props;

const SRC = '/media/game-agents/wh3-cavalry-flank.json';
const r: Replay = JSON.parse(
  fs.readFileSync(path.join(process.cwd(), 'public/media/game-agents/wh3-cavalry-flank.json'), 'utf8')
);
const applied = appliedOrder(r.decisions);
const km = r.key_moment;
const T0 = km?.at ?? r.decisions[applied[0]]?.t ?? start(r);
const m = momentAt(r, applied, T0);
const fr = frameOf(r);
const t0 = start(r);
const t1 = end(r);
const outcome = r.meta.outcome === 'won' ? `Won in ${clock(r.meta.battle_s)}` : `${r.meta.outcome} at ${clock(r.meta.battle_s)}`;
const model = r.meta.model;
const setting = `${r.meta.effort} reasoning, ${r.meta.prompt}`;
const modelUnits = r.units.filter((u) => u.side === 'model');
const aiUnits = r.units.filter((u) => u.side === 'ai');
const sideOf = new Map(r.units.map((u) => [u.id, u.side]));
const uid = `br-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class:list={['br', `br--${variant}`, className]}
  data-battle-replay
  data-src={SRC}
  data-t={T0}
>
  <figure class="br__fig" aria-labelledby={`${uid}-cap`}>
    <div class="br__frame">
      <div class="br__stage">
        <div
          class="br__map"
          tabindex="0"
          role="group"
          aria-label="Battle map. Left and right arrow keys step one recorded sample; Space or K plays and pauses."
        >
          <svg class="br__svg" viewBox={viewBox(fr)} role="img" aria-label={mapLabel(r, m)} data-map>
            <g set:html={groundSVG(r)} />
            <g class="m-dyn" data-dyn set:html={unitsSVG(r, m, { view: true, mk: 1 })} />
            <Fragment set:html={furnitureSVG(r)} />
          </svg>
          <ul class="visually-hidden" data-unit-list set:html={unitListHTML(r, m)} />
        </div>

        <div class="br__controls">
          <div class="br__viewrow">
            <button type="button" class="br__btn br__toggle" data-act="view" aria-pressed="true" disabled data-js>Model’s view</button>
            <p class="br__viewline" data-viewline>{viewText(m)}</p>
          </div>
          <div class="br__transport" data-js>
            <button type="button" class="br__btn br__play" data-act="play" aria-pressed="false" disabled>Play</button>
            <span class="br__clock" data-clock aria-hidden="true">{timeText(r, T0)}</span>
            <input
              type="range"
              class="br__scrub"
              data-scrub
              aria-label="Battle time"
              min={t0}
              max={t1}
              step="0.1"
              value={T0}
              aria-valuetext={timeValueText(r, T0)}
              disabled
            />
            <div class="br__strip" data-strip aria-hidden="true" style={`--head:${pctOf(r, T0)}%`} set:html={stripHTML(r)} />
          </div>
          <div class="br__buttons" data-js>
            <button type="button" class="br__btn" data-act="prev" disabled>Previous decision</button>
            <button type="button" class="br__btn" data-act="next" disabled>Next decision</button>
            <button type="button" class="br__btn" data-act="key" disabled>Watch the key moment</button>
            <label class="br__speed">
              <span>Replay speed</span>
              <select data-speed disabled>
                <option value="1">1×</option>
                <option value="4" selected>4×</option>
                <option value="16">16×</option>
              </select>
              <span class="br__speed-note">the real battle ran at 1×</span>
            </label>
          </div>
          <p class="br__status" data-status role="status"></p>
          <button type="button" class="br__btn" data-retry hidden>Retry loading the recording</button>
        </div>
      </div>

      <div class="br__panel">
        <div class="br__panel-inner">
          <div class="br__ph">
            <p class="br__model"><strong>{model}</strong> <span>{setting}</span></p>
            <p class="br__result"><span>{outcome}</span><span class="br__pclock" data-pclock>{timeText(r, T0)}</span></p>
            <p class="br__waiting" data-waiting>{waitingText(r, m)}</p>
          </div>
          <div
            class="br__decision"
            data-decision
            tabindex="0"
            role="region"
            aria-label="The decision in force"
            set:html={decisionHTML(r, m)}
          />
          <div class="br__note" data-note hidden={m.note < 0} set:html={noteHTML(r, m)} />
        </div>
      </div>
    </div>

    <figcaption class="caption br__caption" id={`${uid}-cap`}>
      {variant === 'full' && <Fragment>{r.meta.heading}. </Fragment>}
      Picked for the maneuver (not a typical result): in this scenario {model} with
      {r.meta.effort} reasoning won 2 of its 9 recorded battles.
      {variant === 'full' && (
        <Fragment>
          Positions were recorded about once a second and never interpolated. Outlines
          mark the model’s view, and the game ran at 1×.
        </Fragment>
      )}
    </figcaption>
  </figure>

  <p class="visually-hidden" aria-live="polite" data-live></p>

  <div class="br__below">
    <details class="br__key">
      <summary>Map key</summary>
      <div class="br__key-body">
        <ul class="br__legend">
          <li>
            <svg class="br__sw" viewBox="-14 -12 28 24" aria-hidden="true"><g class="u u--model"><g class="mk"><circle r="7.5" /></g></g></svg>
            <span><span class="br__nowrap">{model}’s</span> units</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="-14 -12 28 24" aria-hidden="true"><g class="u u--ai"><g class="mk"><path d="M0 -9.5L9.5 0 0 9.5-9.5 0Z" /></g></g></svg>
            <span>Game AI units</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="-14 -14 28 28" aria-hidden="true"><g class="u u--model is-melee"><g class="mk"><circle class="u-ring" r="12.5" /><circle r="7.5" /></g></g></svg>
            <span>Ring: in melee</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="-14 -12 28 24" aria-hidden="true"><g class="u u--ai is-fleeing"><g class="mk"><path d="M0 -9.5L9.5 0 0 9.5-9.5 0Z" /></g></g></svg>
            <span>Faded and dashed, labeled “fleeing”: fleeing</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="-14 -12 28 24" aria-hidden="true"><g class="u u--ai is-unseen"><g class="mk"><path d="M0 -9.5L9.5 0 0 9.5-9.5 0Z" /></g></g></svg>
            <span>Enemy out of sight: where <span class="br__nowrap">{model}’s</span> army last saw it</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="0 -12 28 24" aria-hidden="true"><polyline class="tr tr--model" points="2,6 12,2 26,-4" /><polyline class="tr-now tr--model" points="12,2 26,-4" /></svg>
            <span>Recorded movement over the last 20 s (fainter: <span class="br__nowrap">{model}’s</span> route since the start)</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="-14 -12 28 24" aria-hidden="true"><line class="v-line" x1="-6" y1="3" x2="9" y2="-3" /><g class="v" transform="translate(-6 3)"><g class="mk"><circle r="7.5" /></g></g></svg>
            <span>Model’s view: where a unit stood in the observation behind the latest applied reply, joined to where it is now</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="0 -12 28 24" aria-hidden="true"><polyline class="rt-move" points="2,4 24,-2" /><circle class="rt-wp" cx="24" cy="-2" r="2.6" /></svg>
            <span>Move ordered in that reply, from where the model saw the unit</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="-14 -14 28 28" aria-hidden="true"><polyline class="rt-atk" points="-13,10 -2,2" /><circle class="rt-tgt" r="9" cx="4" cy="-3" /></svg>
            <span>Attack ordered in that reply, and its target</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="-14 -12 28 24" aria-hidden="true"><path class="rt-x" d="M-5 -5l10 10m0-10l-10 10" /></svg>
            <span>A move the game rejected</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="0 0 28 24" aria-hidden="true"><rect class="m-terrain" x="6" y="4" width="16" height="16" /></svg>
            <span>Ground the game reported as restricted at deployment (coarse 32 m cells)</span>
          </li>
          <li>
            <svg class="br__sw" viewBox="0 0 28 24" aria-hidden="true"><rect class="sw-tick" x="5" y="7" width="2" height="12" /><rect class="sw-tick sw-tick--bad" x="11" y="2" width="2" height="17" /><rect class="sw-note" x="16" y="2" width="11" height="4" /></svg>
            <span>Timeline: a tick for each reply the game applied (taller where an order was rejected), and gold bands mark the analyst notes</span>
          </li>
        </ul>
        <div class="br__names">
          <p class="br__names-h">Labels</p>
          <ul>
            {modelUnits.map((u) => <li><span class="br__abbr br__abbr--model">{u.short}</span> {u.name}</li>)}
          </ul>
          <ul>
            {aiUnits.map((u) => <li><span class="br__abbr br__abbr--ai">{u.short}</span> {u.name}</li>)}
          </ul>
        </div>
      </div>
    </details>

    {variant === 'full' && (
      <details class="br__events br__key">
        <summary id={`${uid}-ev`}>Recorded events</summary>
        <ul aria-labelledby={`${uid}-ev`}>
          {r.events.map((e) => (
            <li>
              <button type="button" class="br__ev" data-seek={e.t} disabled>
                <span class={`br__ev-mark br__ev-mark--${e.unit ? sideOf.get(e.unit) : 'end'}`} aria-hidden="true" />
                <span class="br__ev-t">{clock(e.t)}</span>
                <span class="br__ev-text">{e.text}</span>
              </button>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>

  <noscript><style is:inline>[data-battle-replay] [data-js]{display:none!important}[data-battle-replay] .br__ev{pointer-events:none}</style></noscript>
</div>

<script>
  import { enhance } from './replay-client';
  for (const root of document.querySelectorAll<HTMLElement>('[data-battle-replay]')) enhance(root);
</script>

<style>
  .br {
    --br-gap: clamp(0.75rem, 2vw, 1.1rem);
    container-type: inline-size;
    hyphens: manual;
  }

  .br__fig {
    margin: 0;
  }

  .br ul,
  .br li {
    margin: 0;
  }

  /* Inside a case study, prose rules would hyphenate the panel's short lines. */
  .br :global(p) {
    hyphens: manual;
  }

  /* ---------- The instrument: map and controls | decision panel ---------- */
  .br__frame {
    display: grid;
    background: var(--bg-plate);
    border: 1px solid var(--border);
    border-radius: var(--radius-plate);
    overflow: hidden;
  }

  .br__stage {
    min-width: 0;
  }

  .br__map {
    container-type: inline-size;
    border-bottom: 1px solid var(--border);
  }

  .br__map:focus-visible {
    outline-offset: -3px;
  }

  .br__svg {
    width: 100%;
    height: auto;
    font-family: var(--font-serif);
    --mk: 1;
  }

  /* Markers and labels keep a readable size on narrow maps. */
  @container (max-width: 44rem) {
    .br__svg {
      --mk: 1.2;
    }
  }

  @container (max-width: 30rem) {
    .br__svg {
      --mk: 1.6;
    }
  }

  @container (max-width: 24rem) {
    .br__svg {
      --mk: 1.9;
    }
  }

  @container (max-width: 20rem) {
    .br__svg {
      --mk: 2.2;
    }
  }

  /* A phone on its side: keep the whole map on screen with the controls. */
  @media (orientation: landscape) and (max-height: 32rem) {
    .br__svg {
      max-height: calc(100svh - 6rem);
    }
  }

  /* Stacked: the panel sits below the map, so it may grow; a minimum height keeps
     short replies from pulling the caption up and down. */
  .br__panel {
    min-width: 0;
    border-top: 1px solid var(--border);
  }

  .br__panel-inner {
    min-height: 30rem;
    display: flex;
    flex-direction: column;
  }

  @container (min-width: 58rem) {
    .br__frame {
      grid-template-columns: minmax(0, 62fr) minmax(0, 38fr);
    }

    /* The left column sets the height; the panel scrolls inside it. */
    .br__panel {
      position: relative;
      height: auto;
      border-top: 0;
      border-left: 1px solid var(--border);
    }

    .br__panel-inner {
      position: absolute;
      inset: 0;
      min-height: 0;
    }

    .br__decision {
      overflow-y: auto;
    }
  }

  /* ---------- Controls ---------- */
  .br__controls {
    display: grid;
    gap: 0.6rem;
    padding: 0.75rem var(--br-gap) 0.95rem;
  }

  .br__viewrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
  }

  .br__viewline {
    flex: 1 1 18rem;
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--step--1);
    font-style: italic;
    line-height: 1.4;
  }

  .br__transport {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    grid-template-areas:
      'play clock scrub'
      '.    .     strip';
    align-items: center;
    column-gap: 0.9rem;
  }

  .br__play {
    grid-area: play;
  }

  .br__clock {
    grid-area: clock;
  }

  .br__scrub {
    grid-area: scrub;
  }

  .br__strip {
    grid-area: strip;
  }

  @container (max-width: 34rem) {
    .br__transport {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'play clock'
        'scrub scrub'
        'strip strip';
      row-gap: 0.2rem;
    }
  }

  .br__btn {
    appearance: none;
    min-height: 2.6rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--bg-control);
    color: var(--fg);
    font-size: 0.98rem;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 120ms ease, color 120ms ease;
  }

  .br__btn:hover:not(:disabled) {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    color: var(--fg-strong);
  }

  .br__btn:disabled {
    cursor: default;
    color: var(--fg-muted);
    opacity: 0.6;
  }

  .br__play {
    min-width: 5.8rem;
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--fg-strong);
    font-weight: 560;
  }

  .br__play[aria-pressed='true'] {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-control));
  }

  .br__clock {
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--fg-strong);
    white-space: nowrap;
  }

  /* A small square carries the toggle's state visually; aria-pressed carries it for
     assistive technology. */
  .br__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
  }

  .br__toggle::before {
    content: '';
    flex: none;
    width: 0.7em;
    height: 0.7em;
    border: 1px solid var(--fg-muted);
    border-radius: 1px;
  }

  .br__toggle[aria-pressed='true']::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  /* Range with a 16 px thumb; the strip is inset by half of it, so both share one axis. */
  .br__scrub {
    -webkit-appearance: none;
    appearance: none;
    display: block;
    width: 100%;
    height: 2.6rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  .br__scrub:disabled {
    cursor: default;
  }

  .br__scrub::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 2px;
    background: var(--border);
  }

  .br__scrub::-moz-range-track {
    height: 3px;
    border-radius: 2px;
    background: var(--border);
  }

  .br__scrub::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -6.5px;
    border-radius: 50%;
    border: 2px solid var(--bg-plate);
    background: var(--fg-strong);
  }

  .br__scrub::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--bg-plate);
    background: var(--fg-strong);
  }

  .br__scrub:focus-visible {
    outline-offset: 0;
  }

  .br__strip {
    position: relative;
    margin: -0.4rem 8px 0;
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .br__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .br__speed {
    flex: 1 1 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.6rem;
    margin-top: 0.1rem;
    font-size: var(--step--1);
    color: var(--fg);
  }

  .br__speed select {
    min-height: 2.6rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--bg-control);
    color: var(--fg-strong);
    font: inherit;
    font-size: 0.98rem;
    cursor: pointer;
  }

  .br__speed select:disabled {
    color: var(--fg-muted);
    cursor: default;
  }

  .br__speed-note {
    color: var(--fg-muted);
    font-style: italic;
  }

  .br__status {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--step--1);
    font-style: italic;
  }

  .br__status:empty {
    display: none;
  }

  @container (max-width: 30rem) {
    .br__buttons .br__btn {
      flex: 1 1 auto;
    }
  }

  /* ---------- Decision panel ---------- */
  .br__ph {
    padding: 0.85rem var(--br-gap) 0.65rem;
    border-bottom: 1px solid var(--rule);
  }

  .br__ph p {
    margin: 0;
    line-height: 1.4;
  }

  .br__model strong {
    color: var(--fg-strong);
    font-size: 1.08rem;
    font-weight: 600;
  }

  .br__model span {
    margin-left: 0.25em;
    color: var(--fg-muted);
    font-size: var(--step--1);
    font-style: italic;
  }

  .br__result {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.15rem !important;
    font-size: var(--step--1);
  }

  .br__pclock {
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .br__waiting {
    min-height: 1.4em;
    margin-top: 0.15rem !important;
    color: var(--fg-muted);
    font-size: var(--step--1);
    font-style: italic;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .br__decision {
    flex: 1 1 auto;
    min-height: 0;
    overscroll-behavior: contain;
    padding: 0.85rem var(--br-gap) 0.8rem;
    font-size: var(--step--1);
    line-height: 1.5;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .br__decision:focus-visible {
    outline-offset: -3px;
  }

  .br__note {
    padding: 0.75rem var(--br-gap) 0.9rem;
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-plate));
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .br__note[hidden] {
    display: none;
  }

  /* Panel content (markup from replay-render.ts). */
  .br :global(.p-applied) {
    margin: 0 0 0.65rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 1rem;
  }

  .br :global(.p-applied strong) {
    color: var(--fg-strong);
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .br :global(.p-count) {
    color: var(--fg-muted);
    font-style: italic;
  }

  .br :global(.p-reply) {
    margin: 0;
  }

  .br :global(.p-reply figcaption) {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.86rem;
    font-style: italic;
  }

  .br :global(.p-reply blockquote) {
    margin: 0.3rem 0 0;
    padding: 0.05rem 0 0.05rem 0.85rem;
    border-left: 2px solid var(--accent);
    color: var(--fg-strong);
    font-size: 1.04rem;
    font-style: italic;
    line-height: 1.45;
  }

  .br :global(.p-reply blockquote p) {
    margin: 0;
  }

  .br :global(.p-ids) {
    margin: 0.45rem 0 0;
    color: var(--fg-muted);
    font-size: 0.86rem;
  }

  .br :global(.p-h) {
    margin: 0.95rem 0 0.25rem;
    color: var(--fg-muted);
    font-size: 0.86rem;
    font-style: italic;
  }

  .br :global(.p-orders) {
    list-style: none;
    padding: 0;
  }

  .br :global(.p-orders li) {
    padding: 0.28rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .br :global(.p-orders li:last-child) {
    border-bottom: 0;
  }

  .br :global(.p-unit) {
    color: var(--fg-strong);
  }

  .br :global(.p-status) {
