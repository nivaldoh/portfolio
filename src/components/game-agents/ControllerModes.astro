---
// Schematic comparison of the two ways a model commands a Total War battle:
// direct control (blocking replies, orders arrive in batches) and the
// asynchronous commander (standing tasks carried out by scripted unit skills
// on every observation). Not to scale; no recorded data is drawn.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const uid = `modes-${Math.random().toString(36).slice(2, 8)}`;

// Positions along a schematic battle-time track, in percent.
const direct = {
  replies: [
    [1, 29],
    [31, 27],
    [60, 34],
  ],
  orders: [30, 58, 94],
};
const commander = {
  plans: [
    [1, 46],
    [49, 47],
  ],
  skills: Array.from({ length: 30 }, (_, i) => 1.6 + i * 3.3),
};
---

<figure class:list={['modes', className]}>
  <div class="modes__grid">
    <section class="mode" aria-labelledby={`${uid}-direct`}>
      <h3 class="mode__title" id={`${uid}-direct`}>Direct control</h3>
      <p class="mode__text">
        The model orders every unit itself, one reply at a time. Between
        replies, units carry on with their last orders.
      </p>
      <div class="lanes" aria-hidden="true">
        <span class="lane__label">Model replies</span>
        <span class="lane">
          {direct.replies.map(([l, w]) => (
            <span class="bar" style={`left:${l}%;width:${w}%`} />
          ))}
        </span>
        <span class="lane__label">Orders reach units</span>
        <span class="lane lane--ticks">
          {direct.orders.map((x) => (
            <span class="tick tick--orders" style={`left:${x}%`} />
          ))}
        </span>
      </div>
    </section>

    <section class="mode" aria-labelledby={`${uid}-commander`}>
      <h3 class="mode__title" id={`${uid}-commander`}>Commander</h3>
      <p class="mode__text">
        The model sets standing tasks (engage, shoot, hold, charge, move) in
        the background. Scripted unit skills apply them to every fresh
        observation while the next plan is still being written.
      </p>
      <div class="lanes" aria-hidden="true">
        <span class="lane__label">Model plans</span>
        <span class="lane">
          {commander.plans.map(([l, w]) => (
            <span class="bar" style={`left:${l}%;width:${w}%`} />
          ))}
        </span>
        <span class="lane__label">Skills act</span>
        <span class="lane lane--ticks">
          {commander.skills.map((x) => (
            <span class="tick" style={`left:${x}%`} />
          ))}
        </span>
      </div>
    </section>
  </div>
  <figcaption>
    Schematic, not to scale. Bars are model requests in flight, and ticks are
    moments when units receive orders. Both controllers act only through the
    same game mod, and the battle runs unpaused throughout.
  </figcaption>
</figure>

<style>
  .modes {
    margin-inline: 0;
  }

  .modes__grid {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-plate);
    overflow: hidden;
  }

  @media (min-width: 40rem) {
    .modes__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mode {
    background: var(--bg-plate);
    padding: 1.1rem 1.2rem 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .mode__title {
    font-size: 1.1rem;
    font-weight: 560;
    margin: 0;
  }

  .mode__text {
    margin: 0.4rem 0 1.1rem;
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .lanes {
    margin-top: auto;
    display: grid;
    gap: 0.25rem;
  }

  .lane__label {
    font-size: var(--step--2);
    font-style: italic;
    color: var(--fg-muted);
    line-height: 1.3;
  }

  .lane__label:not(:first-child) {
    margin-top: 0.45rem;
  }

  .lane {
    position: relative;
    display: block;
    height: 0.85rem;
    background: var(--data-grid);
    border-radius: 1px;
  }

  .bar {
    position: absolute;
    top: 0;
    bottom: 0;
    background: color-mix(in srgb, var(--data-model) 70%, transparent);
    border-radius: 1px;
  }

  .tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: var(--fg-muted);
  }

  .tick--orders {
    width: 3px;
    background: var(--fg-strong);
  }
</style>
