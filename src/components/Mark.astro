---
interface Props {
  size?: number;
  class?: string;
}

const { size = 14, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1" />
  <circle cx="12" cy="12" r="1.5" fill="currentColor" />
</svg>
