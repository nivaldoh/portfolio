---
import { SITE_TITLE, RESUME_URL } from '../consts';

const path = Astro.url.pathname;
const inProjects = path.startsWith('/projects/');

const links = [
  { href: '/#work', label: 'Work', current: inProjects },
  { href: '/#about', label: 'About', current: false },
  { href: RESUME_URL, label: 'Résumé', current: false },
  { href: '/#contact', label: 'Contact', current: false },
];
---

<header class="site-header">
  <div class="container">
    <a class="site-title" href="/">{SITE_TITLE}</a>
    <nav class="site-nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={l.current ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>
