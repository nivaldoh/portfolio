---
import { SOCIAL_LINKS } from '../consts';
import Mark from './Mark.astro';
---

<footer class="site-footer">
  <div class="container">
    <span class="colophon">
      Charted from a darker corner of the web
      <span aria-hidden="true"> · </span>
      <Mark size={11} />
    </span>
    <span>
      <a href="/rss.xml">RSS</a>
      {SOCIAL_LINKS.map((l) => (
        <>
          <span aria-hidden="true"> · </span>
          <a href={l.url} rel="me noopener">{l.label}</a>
        </>
      ))}
    </span>
  </div>
</footer>

<style>
  .colophon {
    display: inline-flex;
    align-items: center;
    gap: 0.05em;
    font-style: italic;
  }
  .colophon svg {
    margin-left: 0.15em;
    vertical-align: middle;
  }
</style>
