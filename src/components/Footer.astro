---
import { SOCIAL_LINKS, EMAIL, SITE_TITLE } from '../consts';
---

<footer class="site-footer">
  <div class="container">
    <span class="colophon">{SITE_TITLE}</span>
    <span>
      {SOCIAL_LINKS.map((l) => (
        <>
          <a href={l.url} rel="me noopener">{l.label}</a>
          <span aria-hidden="true"> · </span>
        </>
      ))}
      <a href={`mailto:${EMAIL}`}>Email</a>
    </span>
  </div>
</footer>

<style>
  .colophon {
    font-style: italic;
  }
</style>
