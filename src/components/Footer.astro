---
import { SOCIAL_LINKS } from '../consts';
---

<footer class="site-footer">
  <div class="container">
    <span class="colophon">Charted from a darker corner of the web</span>
    <span>
      <a href="/rss.xml">RSS</a>
      {SOCIAL_LINKS.map((l) => (
        <>
          <span aria-hidden="true"> · </span>
          <a href={l.url} rel="me noopener">{l.label}</a>
        </>
      ))}
    </span>
  </div>
</footer>

<style>
  .colophon {
    font-style: italic;
  }
</style>
