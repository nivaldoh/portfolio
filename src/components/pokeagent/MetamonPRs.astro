---
// My Metamon work as two cards: PR #65, merged into the public
// UT-Austin-RPL/metamon (maintained by Jake Grigsby), with its one-line
// follow-up #70; then an experiment in the lab's private development
// repository (still an open PR there; presented as an experiment, without its
// PR state). Each card says what was slow, what changed and what was checked;
// no diff sizes. The panel around it names and links the repository. Static
// HTML, no script.
//
// Read with gh and git on 17 Oct 2026; dates are UTC:
//   PR #65 "Team prediction improvements", merged 2026-01-31T23:01:23Z.
//     Before (579ccc1fb~1, metamon/backend/team_prediction/validate.py): one
//     `npx pokemon-showdown validate-team <format>` subprocess per team file.
//     That CLI runs `node build` (esbuild over Showdown's TypeScript) whenever
//     ./dist is missing in the working directory, as it is at the repo root.
//     After (579ccc1fb): tools/persistent_showdown_validator.js, one node
//     process that loads Showdown once, keeps TeamValidator.get(format) per
//     format and reads one JSON line per team; the CLI stays as a fallback.
//     On 2026-01-28 the 25,192-file gen9ou modern_replays set went through
//     the new path, and a gen1ou run that included a Mewtwo team (banned in
//     Gen 1 OU) rejected exactly that file. The maintainers extended it
//     (jakegrigsby, 2026-05-21, multiprocessing Pool) and it is on main.
//     Re-measured on 2026-10-17 (Ryzen 5 5600X, WSL2, Node 18.20.8,
//     pokemon-showdown 0.11.10) on the first 200 gen9ou files: old CLI with
//     the rebuild, median 1.008 s per team (205.9 s for 200); without the
//     rebuild 0.268 s; the persistent validator started in 0.33 s, then a
//     median of 1.1 ms per team (0.61 s for all 200). All paths agreed,
//     including on 7 deliberately invalid teams. Driver and raw timings:
//     dev/metamon-validator-bench/ (local, git-ignored).
//   PR #70 "Fix error when creating usage stats JSON files", merged
//     2026-02-01T03:08:01Z, a follow-up once #65 reached dev.
//   metamon-dev #111 "Grouped encoder improvements" (private), opened
//     2026-02-06, still open; continues the closed public #78. The ~10% is
//     the owner's review comment of 2 Mar 2026 ("runs ~10% faster than the
//     V2"), from profiling/profile_tstep_encoders.py: median latency of one
//     encoder forward pass in torch.inference_mode at B1_L1, B4_L1 and B16_L1.
//     run_ab_comparison.sh passes reduce-overhead, which reaches only the
//     rewrite's constructor, so the baseline ran in torch.compile's default
//     mode; training speed was never measured. Gates: outputs match the
//     baseline (atol 3e-6, rtol 1e-5) and no slowdown at B4_L1 nor more than
//     5% at any other shape; built "to get an LLM to test a bunch of small
//     experiments in parallel" (review comment, 2 Mar 2026). Not linked: the
//     repository is private.

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const REPO = 'https://github.com/UT-Austin-RPL/metamon';

// What was slow, what changed, what came of it.
const validator = [
  { label: 'Before', text: 'A new Showdown process per team file. Each one reloaded the game data, and rebuilt Showdown first because the script ran from the repository root' },
  { label: 'After', text: 'One validator process for the whole run, with teams sent one line at a time over a pipe' },
  { label: 'Result', text: '200 Gen 9 OU teams in 0.6 s instead of 3.4 minutes, re-timed in October 2026' },
];

const also = [
  { icon: 'funnel', text: 'Usage statistics filtered by Smogon rank' },
  { icon: 'backoff', text: 'Scraper: exponential backoff and a concurrency cap, after timeouts' },
];
---

<div class:list={['mpr', className]}>
  <ul class="mpr__list" aria-label="My work on Metamon">
    <li class="mpr__card mpr__card--merged">
      <p class="mpr__meta">
        <span class="mpr__state">
          <svg class="mpr__merge" viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="4.5" cy="3.5" r="1.9" />
            <circle cx="4.5" cy="12.5" r="1.9" />
            <circle cx="11.5" cy="8" r="1.9" />
            <path d="M4.5 5.4v5.2M4.5 5.4c0 1.6 1.2 2.6 3 2.6h2.1" />
          </svg>
          Merged
        </span>
        <span class="mpr__num">#65</span>
        <span class="mpr__when"><time datetime="2026-01-31T23:01:23Z">31 Jan 2026</time> · still on main</span>
      </p>
      <p class="mpr__title">
        <a href={`${REPO}/pull/65`}>Faster team validation<svg class="mpr__out" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4" /></svg></a>
      </p>

      <dl class="mpr__ba">
        {validator.map((row) => (
          <div class:list={['mpr__ba-row', `mpr__ba-row--${row.label.toLowerCase()}`]}>
            <dt>{row.label}</dt>
            <dd>{row.text}</dd>
          </div>
        ))}
      </dl>

      <ul class="mpr__changes" aria-label="Also in this pull request">
        {also.map((change) => (
          <li class="mpr__change">
            <svg class="mpr__icon" viewBox="0 0 16 16" aria-hidden="true">
              {change.icon === 'funnel' && <path d="M2 3h12l-4.6 5.4v4.8l-2.8-1.4V8.4z" />}
              {change.icon === 'backoff' && <path d="M1 10.5a1 1 0 0 1 2 0a2 2 0 0 1 4 0a4 4 0 0 1 8 0" />}
            </svg>
            <span class="mpr__text">{change.text}</span>
          </li>
        ))}
      </ul>
      <p class="mpr__note">
        Follow-up: <a href={`${REPO}/pull/70`}>#70</a>, a small fix merged the next day.
      </p>
    </li>

    <li class="mpr__card mpr__card--experiment">
      <p class="mpr__meta">
        <span class="mpr__state">
          <svg class="mpr__merge" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M6 1.8h4M6.6 1.8v4.4L2.9 12.6a1.1 1.1 0 0 0 1 1.6h8.2a1.1 1.1 0 0 0 1-1.6L9.4 6.2V1.8" />
            <path d="M4.6 9.6h6.8" />
          </svg>
          Experiment
        </span>
        <span class="mpr__num">#111</span>
        <span class="mpr__when"><time datetime="2026-02-06">Feb–Mar 2026</time> · not merged</span>
      </p>
      <p class="mpr__title">Grouped encoder rewrite</p>
      <p class="mpr__where">In the lab’s private development repository</p>

      <ul class="mpr__changes">
        <li class="mpr__change">
          <svg class="mpr__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M9 1.5 3.5 9h4L6.5 14.5 12.5 7h-4z" /></svg>
          <span class="mpr__text">
            An encoder rewrite that runs under CUDA graphs
            <span class="mpr__tag">~10% faster at inference</span>
          </span>
        </li>
        <li class="mpr__change">
          <svg class="mpr__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4.5h12M2 11.5h12" /><path d="M5.5 2.5v4M10.5 9.5v4" /></svg>
          <span class="mpr__text">A profiler that keeps a change only if it passes two gates</span>
        </li>
      </ul>

      <div class="mpr__gates-wrap">
        <ol class="mpr__gates" aria-label="How the profiler decides">
          <li class="mpr__step"><span class="mpr__chip mpr__chip--in">A change</span></li>
          <li class="mpr__step">
            <span class="mpr__chip">Same outputs?</span>
            <span class="mpr__drop">else drop</span>
          </li>
          <li class="mpr__step">
            <span class="mpr__chip">Not slower?</span>
            <span class="mpr__drop">else drop</span>
          </li>
          <li class="mpr__step"><span class="mpr__chip mpr__chip--keep">Keep</span></li>
        </ol>
        <p class="mpr__why">
          Built so a coding agent could try many small optimizations and keep
          only the ones that pass. The baseline ran in a different compile
          mode, so the 10% isn’t the rewrite alone.
        </p>
      </div>
    </li>
  </ul>
</div>

<style>
  .mpr {
    min-width: 0;
  }

  .mpr__meta,
  .mpr__title,
  .mpr__note {
    margin: 0;
  }

  .mpr__list,
  .mpr__changes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mpr__list {
    display: grid;
    gap: 0.75rem;
  }

  /* Same surface as the .plate frames beside it in the panel pair. */
  .mpr__card {
    background: var(--bg-plate);
    border: 1px solid var(--border);
    border-radius: var(--radius-plate);
    padding: 1rem clamp(0.875rem, 3.5vw, 1.35rem) 1.1rem;
    min-width: 0;
  }

  /* Merged · #65 ............ 31 Jan 2026 → dev_staging */
  .mpr__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.4;
  }

  .mpr__state {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--data-ok);
    align-self: center;
  }

  .mpr__merge {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .mpr__num {
    color: var(--fg-strong);
  }

  .mpr__when {
    margin-left: auto;
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .mpr__title {
    margin-top: 0.45rem;
    font-size: var(--step-1);
    font-weight: 460;
    line-height: 1.2;
    text-wrap: balance;
  }

  .mpr__title a {
    color: var(--fg-strong);
    text-decoration: none;
  }

  .mpr__title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .mpr__out {
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    margin-left: 0.3em;
    vertical-align: 0.1em;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Before / After / Result, with the label in a narrow mono column. */
  .mpr__ba {
    display: grid;
    gap: 0.45rem;
    margin: 0.85rem 0 0;
  }

  .mpr__ba-row {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: baseline;
  }

  .mpr__ba dt {
    font: var(--step--2)/1.4 var(--font-mono);
    color: var(--fg-muted);
  }

  .mpr__ba dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--fg);
    text-wrap: pretty;
  }

  .mpr__ba-row--result dt {
    color: var(--data-ok);
  }

  .mpr__ba-row--result dd {
    color: var(--fg-strong);
  }

  .mpr__note {
    margin-top: 0.8rem;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--fg-muted);
  }

  .mpr__changes {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.95rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }

  .mpr__change {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--fg);
  }

  /* Rows wrap on small phones; balance them instead of leaving one word. */
  .mpr__text {
    text-wrap: balance;
  }

  .mpr__icon {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15em;
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mpr__tag {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--fg-muted);
    white-space: nowrap;
    vertical-align: 0.08em;
  }

  /* ---------- The experiment ---------- */
  .mpr__card--experiment {
    container-type: inline-size;
    container-name: mpr-open;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--fg-muted) 55%, var(--border));
  }

  .mpr__card--experiment .mpr__state {
    color: var(--fg-strong);
  }

  .mpr__where {
    margin: 0.25rem 0 0;
    font-size: var(--step--1);
    font-style: italic;
    line-height: 1.4;
    color: var(--fg-muted);
  }

  /* A change → Same outputs? → Not slower? → Keep. Stacked with downward
     arrows on narrow cards; one row with arrows between on wider ones. */
  .mpr__gates-wrap {
    margin: 0.75rem 0 0 1.8rem;
  }

  .mpr__gates {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mpr__step {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .mpr__chip {
    position: relative;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--bg-elev);
    color: var(--fg-strong);
    font-size: var(--step--1);
    line-height: 1.35;
    white-space: nowrap;
  }

  .mpr__chip--in {
    border-style: dashed;
    color: var(--fg);
  }

  .mpr__chip--keep {
    border-color: var(--data-ok);
    color: var(--data-ok);
  }

  .mpr__chip--keep::before {
    content: '✓ ';
  }

  /* An arrow after every step but the last: down here, across when the
     steps share a row. */
  .mpr__step:not(:last-child) .mpr__chip::after {
    content: '↓';
    position: absolute;
    left: 0.55rem;
    top: calc(100% - 0.05rem);
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.1;
  }

  .mpr__drop {
    color: var(--data-miss);
    font: var(--step--2)/1.3 var(--font-mono);
    white-space: nowrap;
  }

  .mpr__drop::before {
    content: '✗ ';
  }

  .mpr__why {
    margin: 0.8rem 0 0;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  @container mpr-open (min-width: 30rem) {
    .mpr__gates {
      grid-template-columns: repeat(4, auto);
      justify-content: start;
      gap: 0 1.7rem;
    }

    .mpr__step {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }

    .mpr__step:not(:last-child) .mpr__chip::after {
      content: '→';
      left: calc(100% + 0.4rem);
      top: 50%;
      transform: translateY(-50%);
    }

    .mpr__drop {
      padding-left: 0.1rem;
    }
  }

  @media (max-width: 30rem) {
    .mpr__change {
      gap: 0.6rem;
      font-size: 0.95rem;
    }
  }
</style>
