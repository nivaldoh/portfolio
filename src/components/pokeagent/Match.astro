---
// One best-of-99 match from the official brackets: two entrants and the games
// each won. The winner is set in heavier ink and announced as such; the
// entrant's match gets a gold outline (the name itself carries the meaning).
import { ENTRANT, hasEntrant, type Match } from './brackets';

interface Props {
  match: Match;
}

const { match } = Astro.props;
const winner = match[0].score > match[1].score ? match[0] : match[1];
---

<div class:list={['match', { 'match--entrant': hasEntrant(match) }]}>
  {match.map((slot) => (
    <div
      class:list={[
        'match__slot',
        { 'match__slot--won': slot === winner, 'match__slot--entrant': slot.name === ENTRANT },
      ]}
    >
      <span class="match__name">{slot.name}</span>
      <span class="match__score">
        {slot.score}
        {slot === winner && <span class="visually-hidden">, won</span>}
      </span>
    </div>
  ))}
</div>

<style>
  .match {
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--bg-elev);
    min-width: 0;
  }

  .match--entrant {
    border-color: var(--accent);
  }

  .match__slot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.38rem 0.7rem;
    font-size: 0.98rem;
    line-height: 1.3;
    color: var(--fg-muted);
  }

  .match__slot + .match__slot {
    border-top: 1px solid var(--rule);
  }

  .match__slot--won {
    color: var(--fg-strong);
    font-weight: 600;
  }

  .match__slot--entrant {
    color: var(--fg-strong);
    font-style: italic;
  }

  .match__name {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .match__score {
    flex: none;
    font-variant-numeric: tabular-nums lining-nums;
  }
</style>
