---
// A framed piece of real media with a caption. `wide` lets it span the full
// container inside a case study (see CaseStudyLayout).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  wide?: boolean;
  /** Responsive widths for srcset; defaults suit a full-container image. */
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  caption,
  wide = false,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 76rem) 72rem, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;

const hasCaption = Boolean(caption) || Astro.slots.has('default');
---

<figure class:list={['plate', { wide }, className]}>
  <div class="plate__frame">
    <Image
      src={src}
      alt={alt}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      loading={loading}
      decoding="async"
    />
  </div>
  {hasCaption && (
    <figcaption>
      {caption}
      <slot />
    </figcaption>
  )}
</figure>
