---
// Expandable technical detail: for what a reviewer may want but the main
// story doesn't need.
interface Props {
  summary: string;
  open?: boolean;
}

const { summary, open = false } = Astro.props;
---

<details class="details" open={open}>
  <summary>{summary}</summary>
  <div class="details__body">
    <slot />
  </div>
</details>
