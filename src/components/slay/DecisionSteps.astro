---
// A recorded Slay the Spire decision in three steps: what the prompt showed,
// what the model chose (with its stated reasons, verbatim) and the next
// recorded state. Data: public/media/game-agents/slay-gambling-chip.json,
// read at build time. Without JavaScript all three steps render as an ordered
// list; with it they become a stepper that shows one step at a time.
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  /** Extra classes on the root, e.g. "wide" inside a case study. */
  class?: string;
}

const { class: className } = Astro.props;

interface Step {
  label: string;
  text: string;
  detail: string[];
  note: string;
}

interface Trace {
  run: {
    model: string;
    effort: string;
    scaffolding: string;
    character: string;
  };
  steps: Step[];
  caveat: string;
}

const trace: Trace = JSON.parse(
  fs.readFileSync(
    path.join(process.cwd(), 'public/media/game-agents/slay-gambling-chip.json'),
    'utf8'
  )
);

const [situation, selection, outcome] = trace.steps;

// ---- Read the recorded state lines -------------------------------------

type Tag = 'selected' | 'drawn' | 'discarded';
interface Card {
  name: string;
  kind: string;
  cost: string;
  tag?: Tag;
}

const after = (step: Step, prefix: string) =>
  step.detail.find((d) => d.startsWith(prefix))?.slice(prefix.length) ?? '';

// "Headbutt (1 attack), Impervious+ (2 skill)" -> cards
const cardsIn = (list: string): Card[] =>
  [...list.matchAll(/([^,()]+?) \((\d+) (\w+)\)/g)].map((m) => ({
    name: m[1].trim(),
    kind: m[3],
    cost: `${m[2]} energy`,
  }));

// "Incoming attack damage this turn: 30, against your 0 block and 25 HP."
const pressure = (step: Step) => {
  const m = after(step, 'Incoming attack damage this turn: ').match(
    /^(\d+), against your (\d+) block and (\d+) HP/
  );
  return m ? { incoming: m[1], block: m[2], hp: m[3] } : undefined;
};

const where = situation.detail[0].match(/Act (\d+), floor (\d+)/);
const hpMax = situation.detail[0].match(/HP \d+\/(\d+)/)?.[1];
const turn = situation.detail.join(' ').match(/turn (\d+)\./)?.[1];
const enemy = after(situation, '[0] ').match(/^([^:]+):.*intent (\w+) (\d+)/);
const enemyName = enemy?.[1] ?? 'Enemy';
const intent = enemy ? `${enemy[2].toLowerCase()} for ${enemy[3]}` : '';

const handBefore = cardsIn(after(situation, 'Hand: '));
const chosen = selection.text.match(/^select (.+?) \(/)?.[1];
const handAfter = cardsIn(after(outcome, 'Hand: '));
const discard = cardsIn(outcome.text.replace(/^[^:]+:/, '')).map(
  (c): Card => ({ ...c, tag: 'discarded' })
);

// Cards in the later hand that were not in the earlier one were drawn.
const left = handBefore.map((c) => c.name);
const chosenAt = left.indexOf(chosen ?? '');
if (chosenAt >= 0) left.splice(chosenAt, 1);
const handAfterTagged = handAfter.map((c): Card => {
  const i = left.indexOf(c.name);
  if (i >= 0) {
    left.splice(i, 1);
    return c;
  }
  return { ...c, tag: 'drawn' };
});

interface Board {
  hand: Card[];
  discard?: Card[];
  state?: { incoming: string; block: string; hp: string };
  blockUnchanged?: boolean;
}

const incomingAfter = outcome.detail.find((d) => d.startsWith('Incoming'));

const before = pressure(situation);
const later = pressure(outcome) ?? before;
const boards: Board[] = [
  { hand: handBefore, state: before },
  {
    hand: handBefore.map((c) =>
      c.name === chosen ? { ...c, tag: 'selected' as const } : c
    ),
    state: before,
  },
  {
    hand: handAfterTagged,
    discard,
    state: later,
    blockUnchanged: later?.block === before?.block,
  },
];

const sources = ['The prompt', 'The model’s choice', 'The next recorded state'];

// "Stated reason: “…”" -> { label, quote }
const reasons = selection.detail.map((d) => {
  const at = d.indexOf(': ');
  return {
    label: d.slice(0, at),
    quote: d.slice(at + 2).replace(/^[“"]|[”"]$/g, ''),
  };
});

const uid = `steps-${Math.random().toString(36).slice(2, 8)}`;
const stepId = (i: number) => `${uid}-${i}`;
const place = where ? `Act ${where[1]}, floor ${where[2]}` : '';
---

<figure
  class:list={['steps', className]}
  data-decision-steps
  aria-labelledby={`${uid}-title`}
>
  <div class="steps__head">
    <p class="steps__title" id={`${uid}-title`}>
      <span class="steps__kind">Recorded trace</span>
      <span>{place}{turn && `, turn ${turn}`}, against the {enemyName}</span>
    </p>
    <div class="steps__tabs" data-controls hidden>
      {trace.steps.map((s, i) => (
        <button
          type="button"
          class="steps__tab"
          data-goto={i}
          aria-controls={stepId(i)}
        >
          <span class="steps__tab-num">{i + 1}</span>
          <span>{s.label}</span>
        </button>
      ))}
    </div>
  </div>

  <ol class="steps__list" role="list">
    {trace.steps.map((s, i) => {
      const board = boards[i];
      return (
        <li
          class:list={['step', { 'is-current': i === 0 }]}
          id={stepId(i)}
          data-step={i}
          data-label={s.label}
        >
          <div class="step__text">
            <h3 class="step__title" id={`${stepId(i)}-h`}>
              <span class="step__num">{i + 1}</span>
              {s.label}
            </h3>
            <p class="step__source">{sources[i]}</p>
            <p class="trace">
              <code>{s.text}</code>
              {i === 2 && incomingAfter && <code>{incomingAfter}</code>}
            </p>

            {i === 1 && (
              <div class="reasons">
                {reasons.map((r) => (
                  <blockquote class="reason">
                    <p class="reason__label">{r.label}</p>
                    <p class="reason__quote">“{r.quote}”</p>
                  </blockquote>
                ))}
              </div>
            )}

            <p class="step__note">{s.note}</p>

            {i === 0 && (
              <details class="raw">
                <summary>All recorded lines from this prompt</summary>
                <ul class="raw__lines">
                  {s.detail.map((d) => (
                    <li>
                      <code>{d}</code>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>

          <div class="step__board">
            {board.state && (
              <dl class="stats">
                <div>
                  <dt>{enemyName}’s intent</dt>
                  <dd>{intent}</dd>
                </div>
                <div>
                  <dt>Your HP</dt>
                  <dd>
                    {board.state.hp}
                    {hpMax && <span class="stats__of"> of {hpMax}</span>}
                  </dd>
                </div>
                <div class:list={{ 'stats--flag': board.blockUnchanged }}>
                  <dt>Your block</dt>
                  <dd>
                    {board.state.block}{board.blockUnchanged && (
                      <span class="stats__of">, unchanged</span>
                    )}
                  </dd>
                </div>
              </dl>
            )}

            <div class="pile">
              <p class="pile__label">Hand</p>
              <ul class="cards" role="list">
                {board.hand.map((c) => (
                  <li class:list={['card', c.tag && `card--${c.tag}`]}>
                    <span class="card__name">{c.name}</span>
                    <span class="card__meta">{c.kind}</span>
                    <span class="card__meta">{c.cost}</span>
                    {c.tag && <span class="card__tag">{c.tag}</span>}
                  </li>
                ))}
              </ul>
            </div>

            {board.discard && (
              <div class="pile pile--discard">
                <p class="pile__label">Discard pile</p>
                <ul class="cards" role="list">
                  {board.discard.map((c) => (
                    <li class:list={['card', c.tag && `card--${c.tag}`]}>
                      <span class="card__name">{c.name}</span>
                      <span class="card__meta">{c.kind}</span>
                      <span class="card__meta">{c.cost}</span>
                      {c.tag && <span class="card__tag">{c.tag}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </li>
      );
    })}
  </ol>

  <div class="steps__pager" data-pager hidden>
    <button type="button" class="action steps__btn" data-prev>Previous</button>
    <p class="steps__count" data-count></p>
    <button type="button" class="action steps__btn" data-next>Next</button>
  </div>

  <figcaption class="steps__caption">
    From a development run with the {trace.run.scaffolding} prompt and
    interface: {trace.run.model} with {trace.run.effort} reasoning effort,
    playing {trace.run.character}.
    Monospaced lines are quoted from the trace; the cards are drawn from the
    recorded hand and discard pile, shown as text. {trace.caveat}
  </figcaption>
</figure>

<style>
  .steps {
    margin-inline: 0;
    background: var(--bg-plate);
    border: 1px solid var(--border);
    border-radius: var(--radius-plate);
    padding: clamp(1rem, 2.5vw, 1.75rem);
  }

  /* ---------- Head: what this is, and the step buttons ---------- */
  .steps__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .steps__title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--fg);
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.6rem;
  }

  .steps__kind {
    font-style: italic;
    color: var(--accent);
  }

  .steps__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--bg-elev);
    flex: 1 1 24rem;
    max-width: 32rem;
  }

  .steps__tabs[hidden] {
    display: none;
  }

  .steps__tab {
    appearance: none;
    border: 0;
    border-radius: 1px;
    background: transparent;
    color: var(--fg-muted);
    min-height: 2.6rem;
    padding: 0.4rem 0.7rem;
    font-size: var(--step--1);
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .steps__tab:hover {
    color: var(--fg);
  }

  .steps__tab[aria-current='step'] {
    background: var(--bg-control);
    color: var(--fg-strong);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .steps__tab-num {
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--fg-muted);
  }

  .steps__tab[aria-current='step'] .steps__tab-num {
    color: var(--accent);
  }

  /* ---------- Steps ---------- */
  .steps__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: grid;
    align-content: start;
    gap: 1.25rem 2.5rem;
    margin: 0;
    padding: 1.4rem 0;
  }

  .step + .step {
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 56rem) {
    .step {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: 'board text';
      align-items: start;
    }

    .step__board {
      grid-area: board;
    }

    .step__text {
      grid-area: text;
    }
  }

  /* With JavaScript: one step at a time, all stacked in one cell so the
     panel keeps the height of the tallest step and never jumps. */
  .steps.is-enhanced .steps__list {
    display: grid;
  }

  .steps.is-enhanced .step {
    grid-area: 1 / 1;
    border-top: 0;
    padding-bottom: 0.4rem;
    visibility: hidden;
    opacity: 0;
  }

  .steps.is-enhanced .step.is-current {
    visibility: visible;
    opacity: 1;
    transition: opacity 220ms ease;
  }

  .step__title {
    font-size: var(--step-1);
    font-weight: 500;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .step__num {
    font-size: 1rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .step__source {
    margin: 0.9rem 0 0.35rem;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--fg-muted);
  }

  .trace {
    margin: 0;
    display: grid;
    gap: 0.4rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    padding: 0.55rem 0.75rem;
  }

  .trace code {
    display: block;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--fg-strong);
    background: none;
    border: 0;
    padding: 0;
    overflow-wrap: anywhere;
  }

  .step__note {
    margin: 0.8rem 0 0;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--fg);
  }

  .reasons {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .reason {
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 2px solid color-mix(in srgb, var(--data-model) 70%, transparent);
  }

  .reason__label {
    margin: 0;
    font-size: var(--step--2);
    font-style: italic;
    color: var(--fg-muted);
  }

  .reason__quote {
    margin: 0.15rem 0 0;
    color: var(--fg-strong);
    line-height: 1.45;
  }

  /* All recorded lines of the first prompt, on demand. */
  .raw {
    margin-top: 1rem;
    font-size: var(--step--1);
  }

  .raw summary {
    cursor: pointer;
    color: var(--accent);
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .raw__lines {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0.6rem 0.75rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    display: grid;
    gap: 0.45rem;
  }

  .raw__lines li {
    margin: 0;
  }

  .raw__lines code {
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  /* ---------- The board: state and cards, as text ---------- */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0 0 1.25rem;
  }

  .stats dt {
    font-size: var(--step--2);
    font-style: italic;
    color: var(--fg-muted);
  }

  .stats dd {
    margin: 0.1rem 0 0;
    color: var(--fg-strong);
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .stats__of {
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .stats--flag dd {
    color: var(--data-miss);
  }

  .pile + .pile {
    margin-top: 1.1rem;
  }

  .pile__label {
    margin: 0 0 0.5rem;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--fg-muted);
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0.55rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .card {
    position: relative;
    flex: 0 0 auto;
    margin: 0;
    width: 6.6rem;
    min-height: 5.2rem;
    padding: 0.5rem 0.55rem 0.45rem;
    display: flex;
    flex-direction: column;
    background: var(--bg-control);
    border: 1px solid var(--border);
    border-radius: var(--radius-plate);
  }

  .card__name {
    color: var(--fg-strong);
    font-size: 0.95rem;
    line-height: 1.2;
    font-weight: 520;
    overflow-wrap: anywhere;
  }

  .card__name + .card__meta {
    margin-top: 0.3rem;
  }

  .card__meta {
    color: var(--fg-muted);
    font-size: var(--step--2);
    line-height: 1.3;
  }

  .card__tag {
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: var(--step--2);
    font-style: italic;
    line-height: 1.2;
  }

  .card--selected {
    border-color: var(--accent);
    transform: translateY(-0.5rem);
  }

  .card--selected .card__tag {
    color: var(--accent);
  }

  .card--discarded {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--data-miss) 75%, transparent);
  }

  .card--discarded .card__tag {
    color: var(--data-miss);
  }

  .card--drawn {
    border-color: color-mix(in srgb, var(--fg-muted) 80%, transparent);
  }

  .card--drawn .card__tag {
    color: var(--fg);
  }

  /* What changed, played only when the visitor moves to a step. */
  @media (prefers-reduced-motion: no-preference) {
    .step.is-entering .card--selected {
      animation: lift 420ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .step.is-entering .card--discarded {
      animation: to-discard 560ms cubic-bezier(0.2, 0.7, 0.2, 1) 80ms both;
    }

    .step.is-entering .card--drawn {
      animation: drawn 420ms ease-out 360ms both;
    }

    .step.is-entering .stats--flag dd {
      animation: settle 500ms ease-out 520ms both;
    }
  }

  @keyframes lift {
    from {
      transform: translateY(0);
      border-color: var(--border);
    }
    to {
      transform: translateY(-0.5rem);
      border-color: var(--accent);
    }
  }

  @keyframes to-discard {
    from {
      transform: translateY(-5.5rem);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes drawn {
    from {
      transform: translateX(0.9rem);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes settle {
    from {
      color: var(--fg-strong);
    }
    to {
      color: var(--data-miss);
    }
  }

  /* ---------- Pager and caption ---------- */
  .steps__pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .steps__pager[hidden] {
    display: none;
  }

  .steps__count {
    margin: 0;
    font-size: var(--step--1);
    color: var(--fg-muted);
    order: -1;
    margin-right: auto;
  }

  .steps__btn[aria-disabled='true'] {
    opacity: 0.45;
    cursor: default;
  }

  .steps__btn[aria-disabled='true']:hover {
    background: transparent;
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .steps__caption {
    margin-top: 1rem;
    max-width: 78ch;
  }

  @media (max-width: 30rem) {
    .steps__tab {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.1rem;
    }

    .card {
      width: auto;
      flex: 1 1 5.5rem;
    }

    .card__name {
      overflow-wrap: normal;
    }

    .pile--discard .card {
      flex: 0 1 8rem;
    }

    .steps__count {
      flex-basis: 100%;
    }

    .steps__btn {
      flex: 1 1 0;
      justify-content: center;
    }
  }
</style>

<script>
  function enhance(root: HTMLElement) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    if (steps.length < 2 || !prev || !next || !count) return;

    let current = 0;

    const show = (index: number, animate: boolean) => {
      const target = Math.max(0, Math.min(steps.length - 1, index));
      const changed = target !== current;
      current = target;
      steps.forEach((step, k) => {
        const on = k === current;
        step.classList.toggle('is-current', on);
        step.classList.remove('is-entering');
        if (on && animate && changed) {
          void step.offsetWidth; // restart the entrance animation
          step.classList.add('is-entering');
        }
      });
      tabs.forEach((tab, k) => {
        if (k === current) tab.setAttribute('aria-current', 'step');
        else tab.removeAttribute('aria-current');
      });
      prev.setAttribute('aria-disabled', String(current === 0));
      next.setAttribute('aria-disabled', String(current === steps.length - 1));
      count.textContent = `Step ${current + 1} of ${steps.length}: ${
        steps[current].dataset.label ?? ''
      }`;
    };

    tabs.forEach((tab, k) => {
      tab.addEventListener('click', () => show(k, true));
      tab.addEventListener('keydown', (e) => {
        let to = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') to = k + 1;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') to = k - 1;
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = tabs.length - 1;
        if (to < 0 || to >= tabs.length) return;
        e.preventDefault();
        show(to, true);
        tabs[to].focus();
      });
    });
    prev.addEventListener('click', () => show(current - 1, true));
    next.addEventListener('click', () => show(current + 1, true));

    root
      .querySelectorAll<HTMLElement>('[data-controls], [data-pager]')
      .forEach((el) => (el.hidden = false));
    root.classList.add('is-enhanced');
    show(0, false);
    count.setAttribute('aria-live', 'polite');
  }

  document
    .querySelectorAll<HTMLElement>('[data-decision-steps]')
    .forEach(enhance);
</script>
