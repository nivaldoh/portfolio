---
// The furthest Slay the Spire run so far (scaffolding version 8, development
// seed RUNDEV2), floor by floor: the model's HP and max HP on floors 1-54
// across the four acts, the room types on the way, the floor 54 elite fight
// that ended it and the unreached Act 4 boss. Data: ./furthest-run.ts, derived
// from runs/fullrun/llm-luna-v8-dev-20261012/run-0001/trace.jsonl in
// nivaldoh/slay_the_spire_ai (local run evidence, job source f36176b) and
// checked against docs/spire/fullrun/log.md and results.csv at 1117518.
//
// Every floor gets the same width; inside a floor its recorded readings are
// drawn in order as steps, evenly spaced (order is real, spacing is not time).
// Nothing is interpolated. Static markup, no script; the plot lines are one
// stretched SVG per act and every label is HTML, so text keeps its size.
import { BOSSES, FLOORS, LAST_FIGHT, NEXT_BOSS, type FloorRecord } from './furthest-run';

interface Props {
  /** Show the one-line caption under the chart. */
  caption?: boolean;
  class?: string;
}

const { caption = true, class: className } = Astro.props;

const W = 10; // viewBox units per floor
const TOP = 100; // HP at the top edge of the plot
const r2 = (n: number) => Math.round(n * 100) / 100;
const pct = (n: number) => `${r2(n * 100)}%`;

type Reading = [number, number];
type Mark = { x: number; kind: string };

const last = FLOORS[FLOORS.length - 1];
const start = FLOORS[0].hp[0];
const act4 = FLOORS.find((f) => f.act === NEXT_BOSS.act);

// Ordered readings as a step path. At the death reading (HP 0) the HP trace
// drops to 0 and ends there; the max-HP ceiling ends just before it.
function steps(floors: FloorRecord[], pick: (r: Reading) => number, drawDeath: boolean) {
  let d = '';
  let endX = 0;
  floors.forEach((f, i) => {
    f.hp.forEach((r, j) => {
      const dead = r[0] === 0;
      if (dead && !drawDeath) return;
      const x0 = r2((i + j / f.hp.length) * W);
      const x1 = r2((i + (j + 1) / f.hp.length) * W);
      const v = pick(r);
      d += d ? `V${TOP - v}` : `M${x0} ${TOP - v}`;
      endX = x0;
      if (dead) return;
      d += `H${x1}`;
      endX = x1;
    });
  });
  return { d, endX };
}

// The largest max-HP cut, located in the data (F29: 94 -> 47).
let cut = { act: 0, floor: 0, x: 0, from: 0, to: 0 };

const panels = [1, 2, 3, 4].map((act) => {
  const floors = FLOORS.filter((f) => f.act === act);
  const first = floors[0].floor;
  const end = act === NEXT_BOSS.act ? NEXT_BOSS.floor : floors[floors.length - 1].floor;
  const slots = end - first + 1;
  const hp = steps(floors, ([h]) => h, true);
  const max = steps(floors, ([, m]) => m, false);

  let prev = act === 1 ? start[1] : FLOORS[FLOORS.indexOf(floors[0]) - 1].hp.at(-1)![1];
  floors.forEach((f, i) =>
    f.hp.forEach(([, m], j) => {
      if (prev - m > cut.from - cut.to) {
        cut = { act, floor: f.floor, x: (i + j / f.hp.length) / slots, from: prev, to: m };
      }
      prev = m;
    })
  );

  const nodes: Mark[] = floors.map((f, i) => ({
    x: (i + 0.5) / slots,
    kind: f === last ? 'end' : f.room,
  }));
  if (act === NEXT_BOSS.act) nodes.push({ x: (slots - 0.5) / slots, kind: 'heart' });

  const ends = act === last.act;
  return {
    act,
    slots,
    w: slots * W,
    line: hp.d,
    area: `${hp.d}V${TOP}H0Z`,
    max: max.d,
    nodes,
    // Path behind the room marks: from the first floor, and for the last act
    // solid to the final floor, then dotted to the unreached boss.
    track: {
      from: act === 1 ? nodes[0].x : 0,
      to: ends ? nodes[floors.length - 1].x : 1,
    },
    unreached: ends ? { from: nodes[floors.length - 1].x, to: nodes[nodes.length - 1].x } : null,
    endX: ends ? hp.endX / (slots * W) : null,
  };
});

const bossList = Object.entries(BOSSES).map(([floor, name]) => `${name} on floor ${floor}`);
const label =
  `Step chart of the furthest Slay the Spire run so far: the model's HP on every floor ` +
  `from 1 to ${last.floor}, across Acts 1 to 4, with its max HP as a ceiling. ` +
  `It starts at ${start[0]} of ${start[1]} HP. Max HP falls from ${cut.from} to ${cut.to} ` +
  `on floor ${cut.floor}. It beats ${bossList.slice(0, -1).join(', ')} and ${bossList.at(-1)}. ` +
  `Act 4 starts at ${act4?.hp[0][0]} of ${act4?.hp[0][1]} HP; on floor ${last.floor} the ` +
  `${LAST_FIGHT} take HP to 0. ${NEXT_BOSS.name}, on floor ${NEXT_BOSS.floor}, is not reached.`;
---

<figure class:list={['plate', 'rp', className]}>
  <div class="plate__frame rp__frame">
    <div class="rp__body" role="img" aria-label={label}>
      <div class="rp__chart">
        {panels.map((p) => (
          <div class="rp__act" style={`--slots:${p.slots}`}>
            <span class="rp__actlabel">Act {p.act}</span>
            <div class="rp__plot">
              <svg class="rp__lines" viewBox={`0 0 ${p.w} ${TOP}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="rp__area" d={p.area} />
                <path class="rp__max" d={p.max} />
                <path class="rp__hp" d={p.line} />
              </svg>
              {p.act === 1 && (
                <Fragment>
                  <span class="rp__tick rp__tick--top" aria-hidden="true">{TOP} HP</span>
                  <span class="rp__tick rp__tick--mid" aria-hidden="true">{TOP / 2}</span>
                </Fragment>
              )}
              {cut.act === p.act && (
                <span class="rp__note" style={`--x:${pct(cut.x)}`}>
                  max HP<br />{cut.from}<svg class="rp__arrow" viewBox="0 0 10 8" aria-hidden="true"><path d="M0.5 4H8.5M5.5 1L8.5 4L5.5 7" /></svg>{cut.to}
                </span>
              )}
              {p.endX !== null && <span class="rp__end" style={`left:${pct(p.endX)}`} />}
            </div>
            <div class="rp__map">
              <span class="rp__track" style={`left:${pct(p.track.from)};right:${pct(1 - p.track.to)}`} />
              {p.unreached && (
                <span
                  class="rp__track rp__track--unreached"
                  style={`left:${pct(p.unreached.from)};right:${pct(1 - p.unreached.to)}`}
                />
              )}
              {p.nodes.map((n) => (
                <span class={`rp__node rp__node--${n.kind}`} style={`left:${pct(n.x)}`} />
              ))}
            </div>
          </div>
        ))}
        <div class="rp__gutter">
          <span class="rp__actlabel" />
          <div class="rp__endplot">
            <p class="rp__endnote">
              <span class="rp__endfloor">Floor {last.floor}</span>
              <span>Spire Shield &amp; Spear</span>
            </p>
          </div>
          <div class="rp__endmap">
            <span>Heart,</span>
            <span>not reached</span>
          </div>
        </div>
      </div>

      <ul class="rp__key">
        <li><span class="rp__swatch rp__swatch--hp" />HP</li>
        <li><span class="rp__swatch rp__swatch--max" />max HP</li>
        <li><span class="rp__node rp__node--elite rp__node--key" />elite</li>
        <li><span class="rp__node rp__node--boss rp__node--key" />boss</li>
        <li><span class="rp__node rp__node--rest rp__node--key" />rest</li>
        <li><span class="rp__node rp__node--shop rp__node--key" />shop</li>
      </ul>
    </div>
  </div>
  {caption && (
    <figcaption>
      Furthest run so far: Act {last.act}, floor {last.floor}. The {LAST_FIGHT} ended it.
    </figcaption>
  )}
</figure>

<style>
  .rp {
    container-type: inline-size;
  }

  .rp__frame {
    padding: clamp(0.85rem, 2.2vw, 1.5rem) clamp(0.85rem, 2.4vw, 1.75rem);
  }

  /* ---------- Grid: one column per floor, so every act shares a scale.
     Wide: one row, 55 floors plus a gutter for the end label.
     Narrow: Acts 1-2, then Acts 3-4 with the gutter filling the row. */
  .rp__chart {
    --plot-h: clamp(8.5rem, 16.5cqi, 12.5rem);
    --glyph: 9px;
    display: grid;
    grid-template-columns: repeat(55, minmax(0, 1fr)) minmax(7rem, 10.5rem);
    row-gap: 1.25rem;
    font: 0.8rem/1.35 var(--font-mono);
    color: var(--fg-muted);
  }

  .rp__act,
  .rp__gutter {
    display: grid;
    grid-template-rows: auto var(--plot-h) auto;
    align-content: start;
    min-width: 0;
  }

  .rp__act {
    grid-column: span var(--slots);
  }

  .rp__actlabel {
    min-height: calc(1.35em + 0.4rem);
    padding: 0 0 0.4rem 0.45rem;
    border-left: 1px solid var(--border);
    white-space: nowrap;
  }

  .rp__gutter .rp__actlabel {
    border-left: 0;
  }

  /* ---------- Plot: HP 0 at the bottom edge, 100 at the top; a faint rule
     at 50 HP runs through every act, labelled once in Act 1. */
  .rp__plot {
    position: relative;
    border-left: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: linear-gradient(
      to bottom,
      transparent calc(50% - 0.5px),
      var(--data-grid) calc(50% - 0.5px),
      var(--data-grid) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
  }

  .rp__tick {
    position: absolute;
    left: 0.35rem;
    z-index: 1;
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 0 3px var(--bg-plate), 0 0 3px var(--bg-plate);
  }

  .rp__tick--top {
    top: 0.2rem;
  }

  .rp__tick--mid {
    top: 50%;
    transform: translateY(calc(-100% - 0.2rem));
  }

  .rp__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
  }

  .rp__area {
    fill: var(--data-model);
    fill-opacity: 0.1;
  }

  .rp__max,
  .rp__hp {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /* Faint, but at least 3:1 against --bg-plate. */
  .rp__max {
    stroke: var(--fg-muted);
    stroke-opacity: 0.75;
    stroke-width: 1;
  }

  .rp__hp {
    stroke: var(--data-model);
    stroke-width: 2;
  }

  /* Just right of the cliff; held inside the act when the panel is narrow. */
  .rp__note {
    position: absolute;
    top: 16%;
    left: min(var(--x), 100% - 2.6rem);
    margin-left: 0.3rem;
    white-space: nowrap;
  }

  .rp__arrow {
    display: inline-block;
    width: 10px;
    height: 8px;
    margin: 0 2px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rp__end {
    position: absolute;
    bottom: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--data-miss);
    box-shadow: 0 0 0 2px var(--bg-plate);
    transform: translate(-50%, 50%);
  }

  /* ---------- Room marks along the route. */
  .rp__map {
    position: relative;
    height: 1.6rem;
    margin-top: 0.3rem;
  }

  .rp__track {
    position: absolute;
    top: 50%;
    height: 0;
    border-top: 1px solid var(--border);
  }

  .rp__track--unreached {
    border-top-style: dotted;
    border-top-color: var(--fg-muted);
    opacity: 0.6;
  }

  .rp__node {
    position: absolute;
    top: 50%;
    width: var(--glyph);
    height: var(--glyph);
    transform: translate(-50%, -50%);
  }

  .rp__node--monster,
  .rp__node--event,
  .rp__node--treasure,
  .rp__node--victory {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--fg-muted);
    opacity: 0.55;
  }

  .rp__node--elite,
  .rp__node--end {
    background: var(--data-ai);
    transform: translate(-50%, -50%) rotate(45deg) scale(0.78);
  }

  .rp__node--end {
    background: var(--data-miss);
  }

  .rp__node--boss {
    background: var(--data-ai);
    transform: translate(-50%, -50%) scale(0.85);
  }

  .rp__node--rest {
    background: var(--fg-muted);
    clip-path: polygon(50% 6%, 100% 94%, 0 94%);
  }

  .rp__node--shop {
    border: 1.5px solid var(--fg-muted);
    border-radius: 50%;
    background: var(--bg-plate);
  }

  .rp__node--heart {
    border: 1px solid var(--fg-muted);
    background: var(--bg-plate);
    opacity: 0.75;
    transform: translate(-50%, -50%) scale(0.85);
  }

  /* ---------- Gutter: the end and the boss that was next. */
  .rp__endplot {
    position: relative;
    border-bottom: 1px solid transparent;
  }

  .rp__endnote {
    position: absolute;
    left: 0.6rem;
    right: 0;
    bottom: 0.15rem;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .rp__endfloor {
    color: var(--fg-strong);
  }

  /* First line centred on the route line; a wrapped second line hangs below. */
  .rp__endmap {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    column-gap: 0.5em;
    min-height: 1.6rem;
    margin-top: 0.3rem;
    padding: calc(0.8rem - 0.675em) 0 0 0.6rem;
  }

  /* ---------- Key */
  .rp__key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.15rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    font: 0.8rem/1.35 var(--font-mono);
    color: var(--fg-muted);
  }

  .rp__key li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .rp__key .rp__node--key {
    --glyph: 9px;
    position: relative;
    top: auto;
    flex: none;
  }

  .rp__key .rp__node--elite {
    transform: rotate(45deg) scale(0.78);
  }

  .rp__key .rp__node--boss {
    transform: scale(0.85);
  }

  .rp__key .rp__node--rest,
  .rp__key .rp__node--shop {
    transform: none;
  }

  .rp__swatch {
    flex: none;
    width: 14px;
    border-top: 2px solid var(--data-model);
  }

  .rp__swatch--max {
    border-top: 1px solid color-mix(in srgb, var(--fg-muted) 75%, transparent);
  }

  @container (max-width: 56rem) {
    .rp__chart {
      --glyph: 8px;
    }
  }

  @container (max-width: 44rem) {
    .rp__chart {
      --plot-h: clamp(7.25rem, 22cqi, 9.5rem);
      --glyph: 7px;
      grid-template-columns: repeat(34, minmax(0, 1fr));
    }

    .rp__gutter {
      grid-column: span 13;
    }

    /* Clear the unreached-Heart mark on the narrowest phones. */
    .rp__endmap {
      padding-left: 0.85rem;
    }

    .rp__key {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      column-gap: 1.5rem;
    }
  }
</style>
