---
interface Props {
  date: Date;
  format?: 'long' | 'short' | 'iso';
}

const { date, format = 'long' } = Astro.props;

const formatted =
  format === 'iso'
    ? date.toISOString().slice(0, 10)
    : date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: format === 'short' ? 'short' : 'long',
        day: 'numeric',
        timeZone: 'UTC',
      });
---

<time datetime={date.toISOString()}>{formatted}</time>
